# Fase Deploy (Render+Neon): en producción esto debe ser
# APP_ENV=production / APP_DEBUG=false — nunca al revés, APP_DEBUG=true
# en producción filtra stack traces completos (rutas de archivo, código
# fuente, valores de config) a cualquier visitante que provoque un error.
APP_NAME="GameBackend"
APP_ENV=local
# Vacío a propósito -nunca commitear una APP_KEY real, ni siquiera acá en
# el .example-. Local: `php artisan key:generate`. Render: generar con
# `php artisan key:generate --show` y pegarla a mano como variable de
# entorno del servicio (ver render.yaml / docs/RENDER_DEPLOYMENT_ANALYSIS.md).
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# En producción: la URL pública real del backend (el dominio que Render
# asigne al servicio, ej. https://game-backend-xxxx.onrender.com), nunca
# localhost.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Desarrollo local: MariaDB/XAMPP (como hoy). Producción: PostgreSQL en
# Neon. Son dos motores distintos A PROPÓSITO — no hay que replicar Neon
# en local ni reemplazar el MariaDB de XAMPP por nada (ver
# docs/RENDER_DEPLOYMENT_ANALYSIS.md, "Implementación Render + Neon").
# La app ya es compatible con ambos: config/database.php trae el bloque
# `pgsql` de fábrica, y el único punto de código que dependía de sintaxis
# específica de MySQL (el default de `characters.appearance_json`) se
# movió al modelo Eloquent.
#
# LOCAL (valores de abajo, sin tocar):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=game_dev
DB_USERNAME=root
DB_PASSWORD=
#
# PRODUCCIÓN (Render, variables reales en el dashboard, NUNCA acá):
#   DB_CONNECTION=pgsql
#   DB_URL=<la "Connection string" que da Neon, empieza con postgres://>
# `DB_URL` alcanza solo -config/database.php ya la soporta nativamente-,
# no hace falta llenar DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# por separado si se usa DB_URL.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Este proyecto autentica 100% por Bearer token (Sanctum personal access
# tokens vía Authorization: Bearer ..., ver web/src/game/net/ApiClient.ts)
# — el frontend NUNCA manda cookies. Por eso SANCTUM_STATEFUL_DOMAINS y
# SESSION_DOMAIN (pensados para el modo "SPA con cookies" de Sanctum) NO
# tienen efecto real acá; se dejan con su default de Laravel sin más.
# Lo único que de verdad importa para CORS/producción es FRONTEND_URL.
SANCTUM_STATEFUL_DOMAINS=localhost:4321
SESSION_DOMAIN=localhost
# En producción: el/los dominio(s) real(es) del frontend en Vercel,
# separados por coma si hace falta más de uno (ver config/cors.php) — ej.
# FRONTEND_URL=https://juego.vercel.app,https://juego-git-main.vercel.app
FRONTEND_URL=http://localhost:4321

VITE_APP_NAME="${APP_NAME}"
