---
// Fase 7: primera UI real de Mascota / expediciones AFK. Mismo patrón que
// /inventory (Fase 6): Astro/HTML puro sobre el sistema de paneles
// existente + <script> de cliente contra ApiClient -Mascota está
// clasificada como Astro/HTML en la tabla de módulos de la Fase 4, no
// Phaser-. Reemplaza el PlaceholderView de esta ruta. No toca AppShell/
// Hud/NavBar/GlobalChat: el layout de 3 columnas (nav | contenido | chat)
// sigue intacto, solo cambia el <slot/> central.
import AppShell from "../layouts/AppShell.astro";
import GamePanel from "../components/ui/GamePanel.astro";
---

<AppShell title="Mascota">
	<div class="mx-auto flex w-full max-w-4xl flex-col gap-4 py-4">
		<p id="pet-error" class="hidden border border-red px-3 py-2 text-sm text-red"></p>

		<!-- F23: solo visible cuando el personaje ya tiene una mascota activa
		     -alterna la vista normal por la colección (mascotas propias +
		     especies disponibles para adoptar). -->
		<div id="pet-toolbar" class="hidden justify-end">
			<button
				id="toggle-collection"
				type="button"
				class="border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg"
			>
				Mis mascotas
			</button>
		</div>

		<!-- F23: estado 1/3 -sin mascota todavía (usuario nuevo o legacy
		     "Compañero" retirado). Elegir una especie starter es gratis. -->
		<div id="no-pet-view" class="hidden flex-col gap-4">
			<GamePanel title="Elegí tu primera mascota" bodyClass="flex flex-col gap-3 p-5">
				<p class="m-0 text-sm text-muted">Todavía no tenés una mascota. Elegí una para empezar -es gratis-.</p>
				<div id="starter-options" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
			</GamePanel>
		</div>

		<!-- F23: estado 3/3 -colección: mascotas propias (identificando cuál
		     está activa, con opción de cambiarla) + especies todavía no
		     adquiridas, comprables por monedas. -->
		<div id="collection-view" class="hidden flex-col gap-4">
			<GamePanel title="Mis mascotas" bodyClass="flex flex-col gap-3 p-5">
				<div id="owned-pets-list" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
			</GamePanel>
			<GamePanel title="Adoptar más especies" bodyClass="flex flex-col gap-3 p-5">
				<div id="available-species-list" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
			</GamePanel>
			<button
				id="close-collection"
				type="button"
				class="w-fit border-2 border-cyan px-4 py-2 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg"
			>
				Volver
			</button>
		</div>

		<!-- F23: estado 2/3 -UI normal existente (F7/F20/F21/F22), ahora
		     dentro de un contenedor que se puede ocultar mientras se navega
		     el resto de estados. -->
		<div id="active-pet-view" class="hidden flex-col gap-4">
		<div class="grid gap-4 sm:grid-cols-[220px_1fr]">
			<GamePanel title="Mi mascota" bodyClass="flex flex-col items-center gap-3 p-5 text-center">
				<div id="pet-portrait" class="pet-sprite" aria-hidden="true"></div>
				<div>
					<p id="pet-name" class="m-0 text-sm text-text">Cargando…</p>
					<p id="pet-species" class="m-0 font-mono text-[0.65rem] text-cyan"></p>
					<p id="pet-level" class="m-0 font-mono text-[0.65rem] uppercase tracking-wide text-muted"></p>
				</div>
				<div class="flex w-full flex-col gap-1">
					<div class="flex items-center justify-between font-mono text-[0.6rem] uppercase tracking-wide text-muted">
						<span>❤ Salud</span>
						<span id="pet-health-label"></span>
					</div>
					<div class="h-[0.4rem] w-full border border-outline-strong bg-bg">
						<div id="pet-health-bar" class="h-full bg-red" style="width:0%"></div>
					</div>
					<div class="mt-1 flex items-center justify-between font-mono text-[0.6rem] uppercase tracking-wide text-muted">
						<span>⚡ Energía</span>
						<span id="pet-energy-label"></span>
					</div>
					<div class="h-[0.4rem] w-full border border-outline-strong bg-bg">
						<div id="pet-energy-bar" class="h-full bg-cyan" style="width:0%"></div>
					</div>
				</div>

				<!-- Fase 20: alimentación -mínimo necesario, sin pantalla
				     propia. La lista sale del catálogo real (GET /pet/food),
				     nunca hardcodeada acá. -->
				<div class="flex w-full flex-col gap-1 border-t border-outline-strong pt-3">
					<p class="m-0 font-mono text-[0.6rem] uppercase tracking-wide text-muted">Alimentar</p>
					<select
						id="feed-select"
						class="w-full border border-outline-strong bg-bg px-2 py-1 text-xs text-text focus:border-cyan focus:outline-none"
					></select>
					<button
						id="feed-button"
						type="button"
						class="w-full border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan"
					>
						Alimentar
					</button>
				</div>
			</GamePanel>

			<GamePanel title="Estado" bodyClass="p-5">
				<div id="pet-status-idle" class="hidden flex-col gap-3">
					<p class="m-0 text-sm text-muted">Tu mascota está descansando. Elegí un destino para explorar.</p>
				</div>

				<div id="pet-status-exploring" class="hidden flex-col gap-2">
					<p class="m-0 text-sm text-text">
						🐾 <span id="exploring-name"></span> está explorando <strong id="exploring-destination"></strong>
					</p>
					<div class="grid grid-cols-2 gap-2 text-xs text-muted sm:grid-cols-3">
						<span>Inicio: <span id="exploring-started" class="text-text"></span></span>
						<span>Regreso: <span id="exploring-finishes" class="text-text"></span></span>
						<span>Restante: <span id="exploring-countdown" class="text-cyan"></span></span>
					</div>
				</div>

				<div id="pet-status-completed" class="hidden flex-col gap-3">
					<p class="m-0 text-sm text-text">
						🐾 ¡Tu mascota regresó de <strong id="completed-destination"></strong>!
					</p>
					<div>
						<p class="m-0 mb-1 font-mono text-[0.65rem] uppercase tracking-wide text-muted">Recompensas</p>
						<div id="completed-loot" class="flex flex-col gap-1 text-sm text-text"></div>
					</div>
					<button
						id="claim-button"
						type="button"
						class="w-fit border-2 border-cyan px-4 py-2 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg"
					>
						Reclamar recompensas
					</button>
				</div>

				<!-- F22: evento interactivo -solo visible cuando hay un
				     checkpoint awaiting_decision. Título/texto/opciones salen
				     del backend (PetPresenter::checkpointEvent), nunca
				     inventados acá. -->
				<div id="event-section" class="hidden mt-3 flex-col gap-2 border-t border-outline-strong pt-3">
					<p class="m-0 font-mono text-[0.65rem] uppercase tracking-wide text-cyan" id="event-title"></p>
					<p class="m-0 text-sm text-text" id="event-text"></p>
					<div id="event-options" class="flex flex-wrap gap-2"></div>
				</div>

				<div id="narrative-section" class="hidden mt-3 flex-col gap-2 border-t border-outline-strong pt-3">
					<p class="m-0 font-mono text-[0.65rem] uppercase tracking-wide text-cyan">📖 Bitácora de aventura</p>
					<p id="narrative-empty" class="m-0 hidden text-sm italic text-muted">
						La aventura acaba de comenzar.<br />Compañero todavía no tiene nada interesante que contar...
					</p>
					<div id="narrative-log" class="flex max-h-[260px] flex-col gap-3 overflow-y-auto pr-1"></div>
				</div>
			</GamePanel>
		</div>

		<GamePanel title="Destinos" bodyClass="flex flex-col gap-3 p-5">
			<!-- F22: carrusel (desktop 3 visibles / tablet 2 / mobile 1),
			     avanza de a UNA tarjeta -ver script, calcCarousel()/
			     renderCarousel(). Sin librerías externas: overflow-hidden +
			     una pista flex movida con transform. -->
				<div class="flex items-center gap-2">
					<button
						id="carousel-prev"
						type="button"
						aria-label="Expedición anterior"
						class="border-2 border-cyan px-2 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-cyan"
					>
						◀
					</button>
					<div id="carousel-viewport" class="flex-1 overflow-hidden">
						<div id="destinations-list" class="flex" style="transition: transform 200ms ease;"></div>
					</div>
					<button
						id="carousel-next"
						type="button"
						aria-label="Siguiente expedición"
						class="border-2 border-cyan px-2 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-cyan"
					>
						▶
					</button>
				</div>
		</GamePanel>

		<GamePanel title="Historial de expediciones" bodyClass="flex flex-col gap-2 p-5">
			<div id="history-list" class="flex flex-col gap-2"></div>
			<p id="history-empty" class="hidden text-sm text-muted">Todavía no completaste ninguna expedición.</p>
		</GamePanel>
		</div>
	</div>
</AppShell>

<script>
	import {
		ApiError,
		adoptPet,
		claimExpedition,
		decideCheckpoint,
		feedPet,
		getExpeditionDefinitions,
		getExpeditionHistory,
		getItemCatalog,
		getMyPets,
		getPet,
		getPetFood,
		getPetSpecies,
		purchasePetSpecies,
		setActivePet,
		startExpedition,
		type ExpeditionDefinitionDto,
		type ItemDto,
		type Pet,
		type PetExpeditionCheckpoint,
		type PetSpriteAnimationsDto,
		type PetSpriteMetaDto,
	} from "../game/net/ApiClient";
	import { toast } from "../game/state/toast";

	const petToolbarEl = document.getElementById("pet-toolbar")!;
	const noPetViewEl = document.getElementById("no-pet-view")!;
	const collectionViewEl = document.getElementById("collection-view")!;
	const activePetViewEl = document.getElementById("active-pet-view")!;
	const starterOptionsEl = document.getElementById("starter-options")!;
	const ownedPetsListEl = document.getElementById("owned-pets-list")!;
	const availableSpeciesListEl = document.getElementById("available-species-list")!;
	const toggleCollectionButton = document.getElementById("toggle-collection") as HTMLButtonElement;
	const closeCollectionButton = document.getElementById("close-collection") as HTMLButtonElement;
	const petPortraitEl = document.getElementById("pet-portrait")!;

	// F23: tamaño de render fijo (coincide con el h-24 w-24 = 96px que tenía
	// el <img> estático anterior) -el spritesheet real es de 443x443 por
	// frame, se escala acá vía background-size, nunca se re-exporta a otro
	// tamaño (los PNG originales quedan intactos).
	const SPRITE_DISPLAY_SIZE = 96;

	function applySpriteFrame(el: HTMLElement, sprite: PetSpriteMetaDto | null, frameIndex: number): void {
		if (!sprite) {
			el.style.backgroundImage = "url('/assets/pets/catsparin.png')";
			el.style.backgroundSize = "contain";
			el.style.backgroundPosition = "center";
			return;
		}
		const scale = SPRITE_DISPLAY_SIZE / sprite.frame_width;
		const bgWidth = sprite.columns * sprite.frame_width * scale;
		const bgHeight = sprite.rows * sprite.frame_height * scale;
		const col = frameIndex % sprite.columns;
		const row = Math.floor(frameIndex / sprite.columns);
		el.style.backgroundImage = `url(${sprite.file})`;
		el.style.backgroundSize = `${bgWidth}px ${bgHeight}px`;
		el.style.backgroundPosition = `-${col * sprite.frame_width * scale}px -${row * sprite.frame_height * scale}px`;
	}

	// F23 (ajuste post-F23): animación del retrato principal, data-driven
	// contra `sprite.animations` -nunca condiciona por species key-. Tres
	// piezas, deliberadamente simples (sin motor de animación genérico):
	//   1. `idle` en loop continuo mientras no pasa nada más.
	//   2. `fidget` interrumpe el loop UNA vez cada tanto (delay aleatorio
	//      entre FIDGET_MIN/MAX_DELAY_MS) y vuelve a `idle` sola -el
	//      "movimiento ocasional" pedido, sin busy-loop ni RNG por frame-.
	//   3. `playPortraitReaction(key)` reproduce `happy`/`excited`/
	//      `interaction` una sola vez (disparado por alimentar/adoptar/
	//      cambiar activa) y al terminar vuelve a `idle` sola.
	// Un solo timer encadenado (setTimeout que se reprograma a sí mismo) en
	// vez de setInterval -necesario porque cada animación puede tener un
	// número distinto de frames y una de ellas debe terminar y ceder el
	// control, cosa que setInterval no puede expresar limpiamente-.
	type PortraitAnimationKey = keyof PetSpriteAnimationsDto;

	const IDLE_FRAME_INTERVAL_MS = 900;
	const REACTION_FRAME_INTERVAL_MS = 350;
	const FIDGET_MIN_DELAY_MS = 6000;
	const FIDGET_MAX_DELAY_MS = 14000;

	let portraitSprite: PetSpriteMetaDto | null = null;
	let portraitTimer: ReturnType<typeof setTimeout> | null = null;
	let portraitFidgetTimer: ReturnType<typeof setTimeout> | null = null;

	function clearPortraitTimers(): void {
		if (portraitTimer) {
			clearTimeout(portraitTimer);
			portraitTimer = null;
		}
		if (portraitFidgetTimer) {
			clearTimeout(portraitFidgetTimer);
			portraitFidgetTimer = null;
		}
	}

	function scheduleFidget(): void {
		if (!portraitSprite || portraitSprite.animations.fidget.length === 0) {
			return;
		}
		const delay = FIDGET_MIN_DELAY_MS + Math.random() * (FIDGET_MAX_DELAY_MS - FIDGET_MIN_DELAY_MS);
		portraitFidgetTimer = setTimeout(() => {
			playPortraitOnce("fidget", playPortraitIdleLoop);
		}, delay);
	}

	function playPortraitIdleLoop(): void {
		if (!portraitSprite) {
			applySpriteFrame(petPortraitEl, null, 0);
			return;
		}
		const frames = portraitSprite.animations.idle.length > 0 ? portraitSprite.animations.idle : [0];
		let i = 0;
		const step = () => {
			applySpriteFrame(petPortraitEl, portraitSprite, frames[i]);
			i = (i + 1) % frames.length;
			portraitTimer = setTimeout(step, IDLE_FRAME_INTERVAL_MS);
		};
		step();
		scheduleFidget();
	}

	// Reproduce `animations[key]` de principio a fin (un frame por vez) y
	// ejecuta `onDone` al terminar -nunca vuelve a `idle` por su cuenta,
	// eso lo decide quien llama (fidget vuelve solo, una reacción también,
	// pero quedan como llamadas explícitas, no un comportamiento oculto).
	function playPortraitOnce(key: PortraitAnimationKey, onDone: () => void): void {
		if (!portraitSprite) {
			onDone();
			return;
		}
		const frames = portraitSprite.animations[key];
		if (!frames || frames.length === 0) {
			onDone();
			return;
		}
		clearPortraitTimers();
		let i = 0;
		const step = () => {
			applySpriteFrame(petPortraitEl, portraitSprite, frames[i]);
			i++;
			portraitTimer = setTimeout(i < frames.length ? step : onDone, REACTION_FRAME_INTERVAL_MS);
		};
		step();
	}

	function startPortraitIdleAnimation(sprite: PetSpriteMetaDto | null): void {
		clearPortraitTimers();
		portraitSprite = sprite;
		playPortraitIdleLoop();
	}

	// F23 (ajuste post-F23): reacciones puntuales conectadas a acciones que
	// YA EXISTEN en /pet -alimentar, adoptar/comprar, cambiar mascota
	// activa-. Si la especie no tiene frames para esa animación (`key` con
	// array vacío), playPortraitOnce() cae directo a onDone sin romper nada.
	function playPortraitReaction(key: "happy" | "excited" | "interaction"): void {
		if (!portraitSprite) {
			return;
		}
		playPortraitOnce(key, playPortraitIdleLoop);
	}

	const errorEl = document.getElementById("pet-error")!;
	const nameEl = document.getElementById("pet-name")!;
	const speciesEl = document.getElementById("pet-species")!;
	const levelEl = document.getElementById("pet-level")!;
	const healthBarEl = document.getElementById("pet-health-bar")!;
	const healthLabelEl = document.getElementById("pet-health-label")!;
	const energyBarEl = document.getElementById("pet-energy-bar")!;
	const energyLabelEl = document.getElementById("pet-energy-label")!;

	const statusIdleEl = document.getElementById("pet-status-idle")!;
	const statusExploringEl = document.getElementById("pet-status-exploring")!;
	const statusCompletedEl = document.getElementById("pet-status-completed")!;

	const exploringNameEl = document.getElementById("exploring-name")!;
	const exploringDestinationEl = document.getElementById("exploring-destination")!;
	const exploringStartedEl = document.getElementById("exploring-started")!;
	const exploringFinishesEl = document.getElementById("exploring-finishes")!;
	const exploringCountdownEl = document.getElementById("exploring-countdown")!;

	const completedDestinationEl = document.getElementById("completed-destination")!;
	const completedLootEl = document.getElementById("completed-loot")!;
	const claimButton = document.getElementById("claim-button") as HTMLButtonElement;

	const eventSectionEl = document.getElementById("event-section")!;
	const eventTitleEl = document.getElementById("event-title")!;
	const eventTextEl = document.getElementById("event-text")!;
	const eventOptionsEl = document.getElementById("event-options")!;

	const carouselPrevButton = document.getElementById("carousel-prev") as HTMLButtonElement;
	const carouselNextButton = document.getElementById("carousel-next") as HTMLButtonElement;
	const destinationsListEl = document.getElementById("destinations-list")!;
	const historyListEl = document.getElementById("history-list")!;
	const historyEmptyEl = document.getElementById("history-empty")!;

	const narrativeSectionEl = document.getElementById("narrative-section")!;
	const narrativeEmptyEl = document.getElementById("narrative-empty")!;
	const narrativeLogEl = document.getElementById("narrative-log")!;

	let itemNames = new Map<string, string>();
	// F21: id de la expedición actual -claimExpedition() ahora necesita el
	// id explícito (antes reclamaba "la actual" sin parámetro).
	let currentExpeditionId: number | null = null;
	// F23 (ajuste post-F23): el retrato animado vive en active-pet-view, que
	// queda oculto mientras la colección está abierta -no tiene sentido
	// reproducir la reacción "interaction" mientras nadie la ve-. Se marca
	// acá cuando setActivePet() tiene éxito y se dispara recién al volver
	// (closeCollectionButton), después de que refresh() ya reconstruyó el
	// retrato con la especie correcta.
	let activePetSwitchedInCollection = false;
	let countdownTimer: ReturnType<typeof setInterval> | null = null;
	let pollTimer: ReturnType<typeof setInterval> | null = null;

	// F7.1.1: la bitácora se re-consulta entera en cada refresh() (GET
	// /v1/pet sigue siendo la única fuente de verdad), pero el DOM se
	// actualiza de forma incremental -solo se agregan las entradas nuevas,
	// nunca se reconstruye la lista completa- para poder animar apenas la
	// entrada que recién "ocurrió" y no todo el feed en cada poll.
	// Clave de dedup = POSICIÓN en el log, no `event_id`: el mismo evento
	// del catálogo puede repetirse más de una vez en una misma expedición
	// (el anti-repetición solo evita las últimas 3 consecutivas, no
	// unicidad global) — usar `event_id` como clave hacía que una
	// repetición legítima nunca se mostrara, porque su id ya figuraba
	// como "renderizado" por la aparición anterior.
	let narrativeExpeditionId: number | null = null;
	let renderedNarrativeCount = 0;

	function showError(message: string): void {
		errorEl.textContent = message;
		errorEl.classList.remove("hidden");
	}

	function clearError(): void {
		errorEl.classList.add("hidden");
	}

	function messageFrom(err: unknown, fallback: string): string {
		if (err instanceof ApiError && err.body && typeof err.body === "object" && "message" in err.body) {
			return String((err.body as { message: unknown }).message ?? fallback);
		}
		return fallback;
	}

	function itemLabel(itemKey: string): string {
		return itemNames.get(itemKey) ?? itemKey;
	}

	function formatDuration(seconds: number): string {
		const minutes = seconds / 60;
		const hours = minutes / 60;
		return hours >= 1 && Number.isInteger(hours) ? `${hours} horas` : `${minutes} min`;
	}

	function stars(difficulty: number): string {
		return "★".repeat(difficulty) + "☆".repeat(Math.max(0, 5 - difficulty));
	}

	// F22: opciones de decisión son datos (config_json.options), no un
	// vocabulario fijo -este mapa es solo presentación en español para las
	// opciones conocidas hoy; cualquier opción futura no mapeada cae a su
	// propio valor con mayúscula inicial, nunca se rompe por una opción
	// nueva que el backend agregue.
	const DECISION_LABELS: Record<string, string> = {
		fight: "Enfrentar",
		flee: "Huir",
		open: "Abrir",
		leave: "Dejarlo",
		help: "Ayudar",
		ignore: "Ignorar",
	};

	function decisionLabel(option: string): string {
		return DECISION_LABELS[option] ?? option.charAt(0).toUpperCase() + option.slice(1);
	}

	// F23: las 3 vistas de /pet son mutuamente excluyentes -no-mascota,
	// normal (activa) y colección-. show*View() solo mueve clases hidden/
	// flex, refresh() sigue siendo la única fuente de qué vista corresponde
	// según si GET /pet devuelve 404 o no. La colección es la única
	// alcanzable solo por click explícito (toggle-collection), nunca la
	// fuerza un refresh automático mientras el jugador la tiene abierta.
	function showNoPetView(): void {
		noPetViewEl.classList.remove("hidden");
		noPetViewEl.classList.add("flex");
		activePetViewEl.classList.add("hidden");
		activePetViewEl.classList.remove("flex");
		collectionViewEl.classList.add("hidden");
		collectionViewEl.classList.remove("flex");
		petToolbarEl.classList.add("hidden");
		petToolbarEl.classList.remove("flex");
		clearPortraitTimers();
		renderStarterOptions().catch((err) => {
			showError(messageFrom(err, "No se pudieron cargar las especies disponibles."));
		});
	}

	function showActivePetView(): void {
		noPetViewEl.classList.add("hidden");
		noPetViewEl.classList.remove("flex");
		petToolbarEl.classList.remove("hidden");
		petToolbarEl.classList.add("flex");
		// No forzar el cierre de la colección si el jugador la tiene abierta
		// -un refresh periódico (poll) no debe interrumpirla-.
		if (collectionViewEl.classList.contains("hidden")) {
			activePetViewEl.classList.remove("hidden");
			activePetViewEl.classList.add("flex");
		}
	}

	// F23 (ajuste visual): `silhouette=true` oculta el sprite -contexto de
	// adopción, la mascota todavía no es del jugador-. Siempre el primer
	// frame de `animations.idle` (el neutral), estático -no se anima acá,
	// eso queda para el retrato principal ya adoptado (playPortraitIdleLoop)-.
	function spriteCard(sprite: PetSpriteMetaDto | null, silhouette = false): HTMLDivElement {
		const box = document.createElement("div");
		box.className = silhouette ? "pet-sprite pet-sprite-silhouette mx-auto" : "pet-sprite mx-auto";
		applySpriteFrame(box, sprite, sprite?.animations?.idle?.[0] ?? 0);
		return box;
	}

	// F23: catálogo de starters -especies con is_starter_option=true. La
	// primera adopción siempre es gratis, validada server-side (F23 #adopt).
	async function renderStarterOptions(): Promise<void> {
		const species = await getPetSpecies();
		const starters = species.filter((s) => s.is_starter_option);

		starterOptionsEl.innerHTML = "";
		for (const s of starters) {
			const card = document.createElement("div");
			// h-full: la tarjeta ocupa toda la altura de su fila de grid
			// (que ya son parejas entre sí -stretch por defecto de CSS
			// grid-, esto solo lo hace explícito). mt-auto en el botón más
			// abajo es lo que realmente lo ancla al fondo sin importar
			// cuántas líneas ocupe la descripción de cada especie.
			card.className = "flex h-full flex-col items-center gap-2 border border-outline-strong p-3 text-center";
			card.appendChild(spriteCard(s.sprite, true));

			const name = document.createElement("p");
			name.className = "m-0 text-sm text-text";
			name.textContent = s.name;
			card.appendChild(name);

			if (s.description) {
				const desc = document.createElement("p");
				desc.className = "m-0 text-xs text-muted";
				desc.textContent = s.description;
				card.appendChild(desc);
			}

			const button = document.createElement("button");
			button.type = "button";
			button.textContent = "Elegir (gratis)";
			button.className =
				"mt-auto w-full border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan";
			button.addEventListener("click", async () => {
				for (const btn of starterOptionsEl.querySelectorAll("button")) {
					(btn as HTMLButtonElement).disabled = true;
				}
				try {
					await adoptPet(s.key);
					toast.success(`¡${s.name} ahora es tu mascota!`);
					await refresh();
					playPortraitReaction("excited");
				} catch (err) {
					toast.error(messageFrom(err, "No se pudo adoptar la mascota."));
					for (const btn of starterOptionsEl.querySelectorAll("button")) {
						(btn as HTMLButtonElement).disabled = false;
					}
				}
			});
			card.appendChild(button);

			starterOptionsEl.appendChild(card);
		}
	}

	// F23: colección -mascotas propias (con cuál está activa) + especies
	// todavía no adquiridas, comprables por monedas (precio siempre server-
	// side, ver PetSpeciesDto.adoption_price -nunca se manda al backend-).
	async function renderCollection(): Promise<void> {
		const [mine, species] = await Promise.all([getMyPets(), getPetSpecies()]);

		ownedPetsListEl.innerHTML = "";
		for (const p of mine.pets) {
			const isActive = p.id === mine.active_pet_id;
			const card = document.createElement("div");
			card.className = `flex h-full flex-col items-center gap-2 border p-3 text-center ${isActive ? "border-cyan" : "border-outline-strong"}`;
			card.appendChild(spriteCard(p.sprite));

			const name = document.createElement("p");
			name.className = "m-0 text-sm text-text";
			name.textContent = `${p.name} · Nv. ${p.level}`;
			card.appendChild(name);

			const speciesLabel = document.createElement("p");
			speciesLabel.className = "m-0 font-mono text-[0.6rem] uppercase tracking-wide text-muted";
			speciesLabel.textContent = p.species_name;
			card.appendChild(speciesLabel);

			if (isActive) {
				const badge = document.createElement("span");
				badge.className = "mt-auto font-mono text-[0.6rem] uppercase tracking-wide text-cyan";
				badge.textContent = "Activa";
				card.appendChild(badge);
			} else {
				const button = document.createElement("button");
				button.type = "button";
				button.textContent = "Activar";
				button.className =
					"mt-auto w-full border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan";
				button.addEventListener("click", async () => {
					button.disabled = true;
					try {
						await setActivePet(p.id);
						toast.success(`${p.name} ahora es tu mascota activa.`);
						activePetSwitchedInCollection = true;
						await renderCollection();
					} catch (err) {
						toast.error(messageFrom(err, "No se pudo activar esa mascota."));
						button.disabled = false;
					}
				});
				card.appendChild(button);
			}

			ownedPetsListEl.appendChild(card);
		}

		availableSpeciesListEl.innerHTML = "";
		const purchasable = species.filter((s) => !s.owned);
		for (const s of purchasable) {
			const card = document.createElement("div");
			card.className = "flex h-full flex-col items-center gap-2 border border-outline-strong p-3 text-center";
			card.appendChild(spriteCard(s.sprite, true));

			const name = document.createElement("p");
			name.className = "m-0 text-sm text-text";
			name.textContent = s.name;
			card.appendChild(name);

			const price = document.createElement("p");
			price.className = "m-0 font-mono text-[0.65rem] text-cyan";
			price.textContent = `${s.adoption_price} monedas`;
			card.appendChild(price);

			const button = document.createElement("button");
			button.type = "button";
			button.textContent = "Adoptar";
			button.className =
				"mt-auto w-full border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan";
			button.addEventListener("click", async () => {
				button.disabled = true;
				try {
					await purchasePetSpecies(s.key);
					toast.success(`¡Adoptaste a ${s.name}!`);
					await renderCollection();
				} catch (err) {
					toast.error(messageFrom(err, "No se pudo adoptar esa especie."));
					button.disabled = false;
				}
			});
			card.appendChild(button);

			availableSpeciesListEl.appendChild(card);
		}
	}

	toggleCollectionButton.addEventListener("click", async () => {
		activePetViewEl.classList.add("hidden");
		activePetViewEl.classList.remove("flex");
		collectionViewEl.classList.remove("hidden");
		collectionViewEl.classList.add("flex");
		try {
			await renderCollection();
		} catch (err) {
			toast.error(messageFrom(err, "No se pudo cargar la colección."));
		}
	});

	closeCollectionButton.addEventListener("click", async () => {
		collectionViewEl.classList.add("hidden");
		collectionViewEl.classList.remove("flex");
		activePetViewEl.classList.remove("hidden");
		activePetViewEl.classList.add("flex");
		// Puede haberse cambiado la mascota activa dentro de la colección
		// -refrescar el estado normal para reflejarlo (retrato/status/etc.)-.
		await refresh();
		if (activePetSwitchedInCollection) {
			activePetSwitchedInCollection = false;
			playPortraitReaction("interaction");
		}
	});

	function formatCountdown(msRemaining: number): string {
		const totalSeconds = Math.max(0, Math.floor(msRemaining / 1000));
		const h = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
		const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
		const s = String(totalSeconds % 60).padStart(2, "0");
		return `${h}:${m}:${s}`;
	}

	function stopCountdown(): void {
		if (countdownTimer) {
			clearInterval(countdownTimer);
			countdownTimer = null;
		}
	}

	// Guard contra refrescos superpuestos: el poll periódico (20s) puede
	// disparar un refresh() mientras otro ya está en vuelo (por ejemplo,
	// justo después de reclamar) y, si la respuesta más vieja llega
	// después que la más nueva, pintaría datos desactualizados encima de
	// los correctos. Un refresh que ve que ya hay otro en curso simplemente
	// se reprograma en vez de correr en paralelo.
	let refreshInFlight = false;
	let refreshQueued = false;

	async function refresh(): Promise<void> {
		if (refreshInFlight) {
			refreshQueued = true;
			return;
		}

		refreshInFlight = true;
		clearError();
		stopCountdown();
		try {
			const pet = await getPet();
			if (!pet) {
				showNoPetView();
				return;
			}
			showActivePetView();
			renderPet(pet);
			await Promise.all([renderExpeditions(pet), renderHistory()]);
		} catch (err) {
			showError(messageFrom(err, "No se pudo cargar la mascota. ¿El backend está corriendo?"));
		} finally {
			refreshInFlight = false;
			if (refreshQueued) {
				refreshQueued = false;
				await refresh();
			}
		}
	}

	function renderPet(pet: Pet): void {
		nameEl.textContent = pet.name;
		speciesEl.textContent = pet.species_name;
		levelEl.textContent = `Nv. ${pet.level} · ${pet.experience} EXP`;
		startPortraitIdleAnimation(pet.sprite);

		healthBarEl.style.width = `${(pet.health / pet.max_health) * 100}%`;
		healthLabelEl.textContent = `${pet.health} / ${pet.max_health}`;
		energyBarEl.style.width = `${(pet.energy / pet.max_energy) * 100}%`;
		energyLabelEl.textContent = `${pet.energy} / ${pet.max_energy}`;

		statusIdleEl.classList.add("hidden");
		statusExploringEl.classList.add("hidden");
		statusCompletedEl.classList.add("hidden");
		statusIdleEl.classList.remove("flex");
		statusExploringEl.classList.remove("flex");
		statusCompletedEl.classList.remove("flex");

		const expedition = pet.expedition;

		if (!expedition || expedition.status === "claimed") {
			statusIdleEl.classList.remove("hidden");
			statusIdleEl.classList.add("flex");
			narrativeSectionEl.classList.add("hidden");
			narrativeSectionEl.classList.remove("flex");
			return;
		}

		renderNarrativeLog(expedition);
		renderEvent(expedition);

		if (expedition.status === "active") {
			statusExploringEl.classList.remove("hidden");
			statusExploringEl.classList.add("flex");
			exploringNameEl.textContent = pet.name;
			exploringDestinationEl.textContent = expedition.expedition_name;
			exploringStartedEl.textContent = new Date(expedition.started_at).toLocaleTimeString();
			exploringFinishesEl.textContent = new Date(expedition.finishes_at).toLocaleTimeString();

			const finishesAt = new Date(expedition.finishes_at).getTime();
			const tick = () => {
				const remaining = finishesAt - Date.now();
				if (remaining <= 0) {
					stopCountdown();
					refresh();
					return;
				}
				exploringCountdownEl.textContent = formatCountdown(remaining);
			};
			tick();
			countdownTimer = setInterval(tick, 1000);
			return;
		}

		// completed, sin reclamar todavía.
		statusCompletedEl.classList.remove("hidden");
		statusCompletedEl.classList.add("flex");
		completedDestinationEl.textContent = expedition.expedition_name;
		currentExpeditionId = expedition.id;

		completedLootEl.innerHTML = expedition.loot
			.map((reward) => `<span>${itemLabel(reward.item_key)} x${reward.quantity}</span>`)
			.join("");
	}

	// F7.1: la bitácora ya viene "revelada" por el backend según el reloj
	// del servidor -acá solo se pinta lo que llega, en orden cronológico
	// (más antiguo primero, como un diario). Nada de esto afecta stats,
	// loot ni tiempo: es puramente cosmético.
	// Umbral para decidir si el jugador "estaba mirando el final" del feed
	// -si es así, una entrada nueva hace auto-scroll; si estaba leyendo
	// entradas viejas más arriba, no se le mueve la lectura-.
	const NARRATIVE_AUTOSCROLL_THRESHOLD_PX = 40;

	// F21: reemplaza narrative_log -ahora la bitácora sale de filtrar
	// expedition.checkpoints por los ya resueltos (payload.text). El
	// backend sigue siendo quien decide qué ya "ocurrió" (solo aparecen acá
	// los checkpoints con status=resolved, nunca los pending) -el cliente
	// solo pinta lo que recibe, mismo principio que F7.1.
	function renderNarrativeLog(expedition: NonNullable<Pet["expedition"]>): void {
		// Visible siempre que haya una expedición activa o completada-sin-
		// reclamar (sección 2/10 de F7.1.1) — incluso antes de que exista
		// el primer evento.
		narrativeSectionEl.classList.remove("hidden");
		narrativeSectionEl.classList.add("flex");

		// Expedición nueva (o la primera vez que se renderiza): arrancar la
		// bitácora de cero en vez de arrastrar entradas de una anterior.
		if (narrativeExpeditionId !== expedition.id) {
			narrativeExpeditionId = expedition.id;
			renderedNarrativeCount = 0;
			narrativeLogEl.innerHTML = "";
		}

		const resolved = expedition.checkpoints.filter(
			(checkpoint): checkpoint is PetExpeditionCheckpoint & { payload: { text: string } } =>
				checkpoint.status === "resolved" && checkpoint.kind === "narrative" && Boolean(checkpoint.payload?.text)
		);
		narrativeEmptyEl.classList.toggle("hidden", resolved.length > 0);

		const newEntries = resolved.slice(renderedNarrativeCount);
		if (newEntries.length === 0) {
			return;
		}

		const wasNearBottom =
			narrativeLogEl.scrollHeight - narrativeLogEl.scrollTop - narrativeLogEl.clientHeight <
			NARRATIVE_AUTOSCROLL_THRESHOLD_PX;

		for (const checkpoint of newEntries) {
			renderedNarrativeCount++;

			const time = new Date(checkpoint.scheduled_at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
			const wrapper = document.createElement("div");
			wrapper.className = "narrative-entry border-l-2 border-outline-strong pl-3";
			wrapper.innerHTML = `
				<span class="font-mono text-[0.6rem] uppercase tracking-wide text-muted">${time}</span>
				<div class="text-sm text-text">${checkpoint.payload.text
					.split("\n")
					.map((line) => `<p class="m-0">${line}</p>`)
					.join("")}</div>
			`;
			narrativeLogEl.appendChild(wrapper);
		}

		// Auto-scroll solo si el jugador ya estaba viendo el final del feed
		// -si estaba leyendo entradas viejas más arriba, no se lo interrumpe-.
		if (wasNearBottom) {
			narrativeLogEl.scrollTop = narrativeLogEl.scrollHeight;
		}
	}

	// F22: checkpoint awaiting_decision -título/texto/opciones vienen
	// resueltos del backend (PetPresenter::checkpointEvent), el cliente
	// solo los pinta y arma un botón por opción. Decidir llama decide(),
	// refresca todo el estado (igual que reclamar/alimentar) y muestra la
	// consecuencia real vía toast -nunca se calcula nada acá-.
	function renderEvent(expedition: NonNullable<Pet["expedition"]>): void {
		const awaiting = expedition.checkpoints.find((c) => c.status === "awaiting_decision" && c.event);

		if (!awaiting || !awaiting.event) {
			eventSectionEl.classList.add("hidden");
			eventSectionEl.classList.remove("flex");
			eventOptionsEl.innerHTML = "";
			return;
		}

		eventSectionEl.classList.remove("hidden");
		eventSectionEl.classList.add("flex");
		eventTitleEl.textContent = awaiting.event.title ?? "Un evento inesperado";
		eventTextEl.textContent = awaiting.event.text;

		eventOptionsEl.innerHTML = "";
		for (const option of awaiting.event.options) {
			const button = document.createElement("button");
			button.type = "button";
			button.textContent = decisionLabel(option);
			button.className =
				"border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan";
			button.addEventListener("click", async () => {
				for (const btn of eventOptionsEl.querySelectorAll("button")) {
					(btn as HTMLButtonElement).disabled = true;
				}
				try {
					const result = await decideCheckpoint(awaiting.id, option);
					const outcome = result.payload?.outcome;
					const messages: Record<string, string> = {
						win: "¡Tu mascota ganó el encuentro!",
						defeat: "Tu mascota resultó herida en el encuentro.",
						fled: "Tu mascota evitó el peligro.",
						loot: "Tu mascota encontró algo dentro.",
						trap: "Era una trampa.",
						nothing: "No había nada de interés.",
						left: "Tu mascota siguió de largo.",
						success: "Tu mascota ayudó con éxito.",
						failure: "El intento no salió bien.",
						ignored: "Tu mascota siguió su camino.",
					};
					toast.success(outcome ? (messages[outcome] ?? "Decisión aplicada.") : "Decisión aplicada.");
					await refresh();
				} catch (err) {
					toast.error(messageFrom(err, "No se pudo aplicar la decisión."));
					for (const btn of eventOptionsEl.querySelectorAll("button")) {
						(btn as HTMLButtonElement).disabled = false;
					}
				}
			});
			eventOptionsEl.appendChild(button);
		}
	}

	// F22: carrusel de destinos -desktop 3 visibles / tablet 2 / mobile 1,
	// avanza de a UNA tarjeta. Cada tarjeta ocupa 100/visibleCount% del
	// viewport; la pista completa mide (total/visibleCount)*100% y se
	// desplaza con translateX en pasos de 100/total% de SU PROPIO ancho
	// -técnica estándar de carrusel manual, sin librerías-.
	let carouselExpeditions: ExpeditionDefinitionDto[] = [];
	let carouselIndex = 0;

	function carouselVisibleCount(): number {
		const width = window.innerWidth;
		if (width >= 1024) return 3; // desktop
		if (width >= 640) return 2; // tablet
		return 1; // mobile
	}

	function layoutCarousel(): void {
		const total = carouselExpeditions.length;
		if (total === 0) return;

		const visibleCount = carouselVisibleCount();
		const maxIndex = Math.max(0, total - visibleCount);
		carouselIndex = Math.min(carouselIndex, maxIndex);

		destinationsListEl.style.width = `${(total / visibleCount) * 100}%`;
		for (const card of Array.from(destinationsListEl.children)) {
			(card as HTMLElement).style.width = `${100 / total}%`;
		}
		destinationsListEl.style.transform = `translateX(-${carouselIndex * (100 / total)}%)`;

		carouselPrevButton.disabled = carouselIndex <= 0;
		carouselNextButton.disabled = carouselIndex >= maxIndex;
	}

	carouselPrevButton.addEventListener("click", () => {
		carouselIndex = Math.max(0, carouselIndex - 1);
		layoutCarousel();
	});
	carouselNextButton.addEventListener("click", () => {
		carouselIndex += 1;
		layoutCarousel();
	});
	window.addEventListener("resize", layoutCarousel);

	// F21: reemplaza renderDestinations -mismo patrón visual, ahora con
	// nivel mínimo (gate real de la mascota) y reward_preview (% ya
	// calculado server-side, ordenado de mayor a menor por
	// PetPresenter::rewardPreview) en vez de loot_min_tier/loot_max_tier
	// cosméticos. F22: recompensas colapsadas por defecto (una fila por
	// recompensa, no un párrafo con comas) + carrusel en vez de grilla
	// 3x2 fija.
	async function renderExpeditions(pet: Pet): Promise<void> {
		const expeditions = await getExpeditionDefinitions();
		carouselExpeditions = expeditions;
		const busy = pet.expedition && pet.expedition.status !== "claimed";

		destinationsListEl.innerHTML = "";
		for (const expedition of expeditions) {
			const belowLevel = pet.level < expedition.min_pet_level;

			const card = document.createElement("div");
			card.className = "flex flex-shrink-0 flex-col gap-2 border border-outline-strong p-3";
			card.innerHTML = `
				<span class="text-sm text-text">${expedition.name}</span>
				<span class="font-mono text-[0.65rem] uppercase tracking-wide text-muted">Dificultad</span>
				<span class="text-cyan">${stars(expedition.difficulty)}</span>
				<span class="font-mono text-[0.65rem] uppercase tracking-wide text-muted">Nivel mínimo</span>
				<span class="text-sm ${belowLevel ? "text-red" : "text-text"}">${expedition.min_pet_level}</span>
				<span class="font-mono text-[0.65rem] uppercase tracking-wide text-muted">Tiempo</span>
				<span class="text-sm text-text">${formatDuration(expedition.duration_seconds)}</span>
			`;

			const rewardsWrapper = document.createElement("div");
			rewardsWrapper.className = "flex flex-col gap-1";

			const rewardsToggle = document.createElement("button");
			rewardsToggle.type = "button";
			rewardsToggle.className =
				"w-fit border border-outline-strong px-2 py-1 font-mono text-[0.6rem] uppercase tracking-wide text-muted transition-colors hover:border-cyan hover:text-cyan";
			rewardsToggle.textContent = "Ver recompensas";

			const rewardsList = document.createElement("div");
			rewardsList.className = "hidden flex-col gap-1 border-t border-outline-strong pt-2";
			rewardsList.innerHTML = expedition.reward_preview.length
				? expedition.reward_preview
						.map(
							(reward) =>
								`<div class="flex items-center justify-between text-xs text-text"><span>${reward.item_name}</span><span class="text-muted">${reward.percent}%</span></div>`
						)
						.join("")
				: `<span class="text-xs text-muted">Sin recompensas configuradas</span>`;

			rewardsToggle.addEventListener("click", () => {
				const isHidden = rewardsList.classList.contains("hidden");
				rewardsList.classList.toggle("hidden", !isHidden);
				rewardsList.classList.toggle("flex", isHidden);
				rewardsToggle.textContent = isHidden ? "Ocultar" : "Ver recompensas";
			});

			rewardsWrapper.appendChild(rewardsToggle);
			rewardsWrapper.appendChild(rewardsList);
			card.appendChild(rewardsWrapper);

			const button = document.createElement("button");
			button.type = "button";
			button.textContent = belowLevel ? `Requiere nivel ${expedition.min_pet_level}` : "Explorar";
			button.className =
				"border-2 border-cyan px-3 py-1 font-mono text-xs text-cyan transition-colors hover:bg-cyan hover:text-bg disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cyan";
			button.disabled = Boolean(busy) || belowLevel;
			button.addEventListener("click", async () => {
				button.disabled = true;
				try {
					await startExpedition(expedition.key);
					await refresh();
				} catch (err) {
					showError(messageFrom(err, "No se pudo iniciar la expedición."));
					button.disabled = Boolean(busy) || belowLevel;
				}
			});
			card.appendChild(button);

			destinationsListEl.appendChild(card);
		}

		layoutCarousel();
	}

	async function renderHistory(): Promise<void> {
		const history = await getExpeditionHistory();
		historyListEl.innerHTML = "";
		historyEmptyEl.classList.toggle("hidden", history.length > 0);

		for (const expedition of history) {
			const row = document.createElement("div");
			row.className = "border border-outline-strong px-3 py-2 text-sm";
			const lootText = expedition.loot.map((r) => `+${r.quantity} ${itemLabel(r.item_key)}`).join(", ") || "Sin loot";
			row.innerHTML = `
				<div class="flex items-center justify-between">
					<span class="text-text">${expedition.expedition_name}</span>
					<span class="font-mono text-[0.6rem] uppercase tracking-wide text-muted">${expedition.status === "claimed" ? "Reclamada" : "Completada"}</span>
				</div>
				<div class="text-xs text-muted">${lootText}</div>
			`;
			historyListEl.appendChild(row);
		}
	}

	// Fase 20: alimentación. La lista de opciones sale una sola vez del
	// catálogo real (nunca hardcodeada) -si el jugador no tiene el item en
	// inventario, el backend ya devuelve un error claro (422) que se
	// muestra por toast, igual que cualquier otra acción puntual de esta
	// página (ver claimButton más abajo).
	const feedSelect = document.getElementById("feed-select") as HTMLSelectElement;
	const feedButton = document.getElementById("feed-button") as HTMLButtonElement;

	async function loadFoodOptions(): Promise<void> {
		try {
			const food = await getPetFood();
			feedSelect.innerHTML = food
				.map((entry) => `<option value="${entry.item_key}">${entry.item_name} (+${entry.exp_value} EXP)</option>`)
				.join("");
			feedButton.disabled = food.length === 0;
		} catch {
			// Sin catálogo de comida disponible -el botón queda deshabilitado,
			// no bloquea el resto de la página (mismo criterio que el
			// catálogo de items en init()).
			feedButton.disabled = true;
		}
	}

	feedButton.addEventListener("click", async () => {
		const foodKey = feedSelect.value;
		if (!foodKey) return;

		feedButton.disabled = true;
		try {
			const { leveled_up } = await feedPet(foodKey);
			toast.success(leveled_up ? "¡Tu mascota subió de nivel!" : "Tu mascota disfrutó la comida.");
			await refresh();
			playPortraitReaction("happy");
		} catch (err) {
			toast.error(messageFrom(err, "No se pudo alimentar a la mascota."));
		} finally {
			feedButton.disabled = false;
		}
	});

	claimButton.addEventListener("click", async () => {
		if (currentExpeditionId === null) {
			return;
		}
		claimButton.disabled = true;
		try {
			const { loot } = await claimExpedition(currentExpeditionId);
			const totalQty = loot.reduce((sum, entry) => sum + entry.quantity, 0);
			toast.success(
				totalQty > 0
					? `Tu mascota volvió con ${totalQty} objeto${totalQty === 1 ? "" : "s"}`
					: "Tu mascota volvió sin objetos esta vez"
			);
			await refresh();
		} catch (err) {
			// Fase 14: feedback de una acción puntual (se clickeó "Reclamar" y
			// falló) -a toast, no al banner de arriba (ese sigue siendo
			// exclusivo de "no se pudo cargar la mascota", ver init()).
			toast.error(messageFrom(err, "No se pudo reclamar la recompensa."));
			claimButton.disabled = false;
		}
	});

	async function init(): Promise<void> {
		try {
			const catalog = await getItemCatalog();
			itemNames = new Map(catalog.map((item: ItemDto) => [item.key, item.name]));
		} catch {
			// Si el catálogo falla, se muestran las item_key crudas -no bloquea el resto de la página.
		}
		await loadFoodOptions();
		await refresh();
	}

	// Poll periódico: el backend es la fuente de verdad (CLAUDE.md #1), el
	// countdown local es solo cosmético entre refrescos.
	pollTimer = setInterval(refresh, 20000);
	window.addEventListener("beforeunload", () => {
		stopCountdown();
		if (pollTimer) clearInterval(pollTimer);
	});

	init();
</script>

<style>
	/* F7.1.1: animación sutil para una entrada nueva de la bitácora -nada
	   de partículas ni efectos grandes, solo un fundido + pequeño
	   desplazamiento, ver sección 6 de la fase-. */
	.narrative-entry {
		animation: narrative-entry-in 200ms ease-out;
	}

	@keyframes narrative-entry-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.narrative-entry {
			animation: none;
		}
	}

</style>

<!-- F23 (ajuste visual, causa raíz del bug de silueta invisible): Astro
     scopea por defecto cada <style> de un componente -agrega
     data-astro-cid-* a los elementos del propio template y reescribe los
     selectores para exigir ese atributo-. `.pet-sprite`/
     `.pet-sprite-silhouette` se usan en divs creados por
     `document.createElement()` dentro de spriteCard() (selector de
     starter, lista de especies comprables) -esos divs NUNCA reciben
     data-astro-cid-* porque no vienen del template, así que la versión
     scopeada de estas reglas jamás los alcanzaba: sin width/height, el div
     quedaba con alto 0 y el sprite era invisible aunque existiera en el
     DOM-. #pet-portrait sí es del template y por eso siempre se vio bien,
     ocultando el bug. is:global saca estas dos reglas del scoping -sin
     colisión posible, `.pet-sprite`/`.pet-sprite-silhouette` no se usan en
     ningún otro archivo del proyecto (verificado)-. -->
<style is:global>
	/* F23: retrato/tarjetas de mascota -spritesheet real recortado vía
	   background-position (ver applySpriteFrame en el script). Pixelado
	   siempre, sin blur/interpolación -estilo Chibikko-. */
	.pet-sprite {
		width: 96px;
		height: 96px;
		background-repeat: no-repeat;
		image-rendering: pixelated;
	}

	/* F23 (ajuste visual): silueta para especies que todavía no son del
	   jugador (starters sin adoptar / especies comprables no poseídas)
	   -brightness(0) lleva cada píxel visible a negro sólido sin tocar el
	   canal alpha, así el recorte/transparencia del spritesheet se
	   conserva intacto, nunca aparece un rectángulo negro-. Una mascota ya
	   adoptada/activa nunca usa esta clase. */
	.pet-sprite-silhouette {
		filter: brightness(0);
	}
</style>
