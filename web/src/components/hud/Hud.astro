---
// Fase 4.1B: HUD como player status bar -grupos visuales separados por
// divisores finos, en vez de una fila plana de elementos-. Sigue siendo
// HTML/CSS puro (Tailwind + theme.css), fuera del canvas de Phaser.
//
// Fase 11: nivel/experiencia/monedas son 100% reales, vía
// game/state/playerState.ts (fuente única: Backend -> ApiClient -> este
// módulo -> HUD/Inicio). El nombre real requiere JS de cliente aparte
// (me()) porque depende del token en localStorage, igual que antes.
import GameBadge from "../ui/GameBadge.astro";
import GameButton from "../ui/GameButton.astro";
import Icon from "../ui/Icon.astro";
import IconButton from "../ui/IconButton.astro";
import ProgressBar from "../ui/ProgressBar.astro";
import ResourceCounter from "../ui/ResourceCounter.astro";
---

<!-- Mobile UX: prioridad explícita nivel/XP/monedas (el resto se compacta,
     nunca se oculta del todo). El logo decorativo y el primer separador
     desaparecen recién por debajo de sm -no aportan información-; nombre
     se acorta en vez de ocultarse (sigue siendo real e identificable);
     monedas deja de estar oculto en mobile (antes "hidden sm:flex" -
     justamente lo contrario de lo que pide esta fase-); "Salir" pasa a
     ícono-solo en mobile con aria-label, mismo criterio que el resto de
     los IconButton del HUD. -->
<header class="game-panel m-2 flex items-center gap-2 px-2 py-2 sm:gap-4 sm:px-3">
  <div class="hidden h-8 w-8 shrink-0 place-items-center border-2 border-outline-strong font-display text-[0.6rem] text-cyan sm:grid">
    ◆
  </div>

  <div class="game-divider hidden sm:block" />

  <div class="flex min-w-0 items-center gap-2">
    <div
      id="hud-avatar"
      class="grid h-8 w-8 shrink-0 place-items-center border-2 border-outline-strong bg-surface-2 font-mono font-bold text-pink sm:h-9 sm:w-9"
    >
      ?
    </div>
    <div class="flex min-w-0 max-w-24 flex-col gap-1 sm:max-w-none sm:min-w-32">
      <span id="hud-name" class="truncate text-sm text-text">Cargando…</span>
      <ProgressBar percent={0} color="cyan" title="Experiencia" fillId="hud-exp-fill" />
    </div>
    <GameBadge id="hud-level" text="Nv. --" variant="cyan" />
  </div>

  <div class="game-divider hidden sm:block" />

  <div class="flex items-center gap-2 sm:gap-4">
    <ResourceCounter icon="coin" value="…" color="pink" title="Monedas" valueId="hud-coins" />
  </div>

  <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
    <IconButton id="hud-chat-toggle" icon="chat" label="Chat global" variant="cyan" />
    <IconButton id="hud-notifications" icon="bell" label="Notificaciones (demo)" variant="red" />
    <div class="game-divider hidden sm:block" />
    <GameButton id="hud-logout" variant="outline" color="red" ariaLabel="Salir">
      <Icon name="logout" class="h-3.5 w-3.5" />
      <span class="hidden sm:inline">Salir</span>
    </GameButton>
  </div>
</header>

<script>
  import { me, logout } from "../../game/net/ApiClient";
  import type { CharacterDto } from "../../game/net/ApiClient";
  import {
    PLAYER_STATE_CHANGED_EVENT,
    expPercent,
    refreshPlayerState,
  } from "../../game/state/playerState";

  const nameEl = document.getElementById("hud-name")!;
  const avatarEl = document.getElementById("hud-avatar")!;
  const coinsEl = document.getElementById("hud-coins")!;
  const levelEl = document.getElementById("hud-level")!;
  const expFillEl = document.getElementById("hud-exp-fill") as HTMLElement | null;

  me()
    .then((user) => {
      nameEl.textContent = user.name;
      avatarEl.textContent = user.name.charAt(0).toUpperCase();
    })
    .catch(() => {
      // Backend caído o sesión inválida: el HUD no debe romperse por eso.
      nameEl.textContent = "Jugador";
      avatarEl.textContent = "?";
    });

  function renderPlayerState(character: CharacterDto): void {
    coinsEl.textContent = character.coins.toLocaleString();
    levelEl.textContent = `Nv. ${character.level}`;
    if (expFillEl) {
      expFillEl.style.width = `${expPercent(character)}%`;
    }
  }

  refreshPlayerState()
    .then(renderPlayerState)
    .catch(() => {
      coinsEl.textContent = "?";
    });

  // Fase 11: fuente única de sincronización del estado del jugador -
  // cualquier acción que cambie nivel/exp/monedas (combate, venta,
  // crafting, futuras compras) dispara este mismo evento, sin que el HUD
  // tenga que saber quién lo disparó.
  window.addEventListener(PLAYER_STATE_CHANGED_EVENT, (event) => {
    renderPlayerState((event as CustomEvent<CharacterDto>).detail);
  });

  document.getElementById("hud-logout")?.addEventListener("click", async () => {
    await logout().catch(() => {});
    window.location.href = "/login";
  });

  // El HUD no gestiona su propio estado de colapso: reusa el toggle que
  // ya vive en GlobalChat.astro para no duplicar esa lógica en dos sitios.
  document.getElementById("hud-chat-toggle")?.addEventListener("click", () => {
    document.getElementById("global-chat-toggle")?.click();
  });
</script>
