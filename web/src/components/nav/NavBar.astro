---
// Fase 4.1B: navegación global. Sigue perteneciendo a Astro, nunca a
// Phaser: son enlaces normales sin ningún acoplamiento al juego. "Mundo"
// es el único módulo que hoy lleva a una vista con Phaser (/play); el
// resto son placeholders hasta sus fases correspondientes. Los íconos
// pasaron de emoji a la fuente central de Icon.astro (mismo lenguaje
// visual en toda la app, reemplazable por pixel-art real sin tocar acá).
import Icon, { type IconName } from "../ui/Icon.astro";

const items: { href: string; label: string; icon: IconName }[] = [
  { href: "/home", label: "Inicio", icon: "home" },
  { href: "/house", label: "Casa", icon: "house" },
  { href: "/pet", label: "Mascota", icon: "pet" },
  { href: "/arena", label: "Arena", icon: "arena" },
  { href: "/play", label: "Mundo", icon: "world" },
  { href: "/social", label: "Social", icon: "social" },
  { href: "/inventory", label: "Inventario", icon: "inventory" },
  { href: "/shop", label: "Tienda", icon: "shop" },
  { href: "/crafting", label: "Crafting", icon: "craft" },
  { href: "/ranking", label: "Ranking", icon: "ranking" },
];

const currentPath = Astro.url.pathname;
---

<!-- Sidebar de escritorio -- sin cambios de comportamiento respecto a antes,
     solo gana "hidden md:flex" (Mobile UX, ver reporte de la tarea): a
     partir de md (768px) es exactamente la misma nav de siempre. Por
     debajo de md queda fuera del flujo por completo -no reserva ancho,
     no empuja nada-, reemplazada por la barra inferior de abajo. -->
<nav class="game-panel m-2 mt-0 hidden w-48 shrink-0 flex-col p-2 md:flex">
  <div class="px-2 pb-2 font-display text-[0.55rem] tracking-wide text-muted">MENÚ</div>

  <div class="flex flex-col gap-1">
    {
      items.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class={
              isActive
                ? "flex items-center gap-2.5 border-l-2 border-pink bg-surface-2 px-2 py-2 text-sm text-pink shadow-pixel-sm"
                : "flex items-center gap-2.5 border-l-2 border-transparent px-2 py-2 text-sm text-muted hover:border-outline-strong hover:text-text"
            }
          >
            <Icon name={item.icon} class="h-4 w-4 shrink-0" />
            <span>{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>

<!-- Barra inferior de mobile (Mobile UX): panel flotante fijo, mismo
     lenguaje visual (game-panel) que el resto de la UI en vez de una barra
     "app" genérica sin bordes. Scroll horizontal como red de seguridad -9
     ítems con etiqueta no entran cómodos en 320-390px sin scroll, y es
     preferible a truncar/ocultar labels (mystery-meat nav) o abrir un menú
     "Más" con estado nuevo-. `position:fixed` -no participa del layout en
     flex de AppShell, así que no hace falta tocar esa fila para nada más
     que el padding inferior de <main>-. -->
<nav
  class="game-panel fixed inset-x-2 bottom-2 z-20 flex items-center gap-0.5 overflow-x-auto p-1.5 md:hidden"
  aria-label="Navegación"
>
  {
    items.map((item) => {
      const isActive = currentPath === item.href;
      return (
        <a
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          class={`flex min-w-11 shrink-0 flex-col items-center gap-0.5 rounded-sm px-1.5 py-1 text-center ${
            isActive ? "text-pink" : "text-muted"
          }`}
        >
          <Icon name={item.icon} class="h-5 w-5 shrink-0" />
          <span class="whitespace-nowrap text-[0.55rem] leading-none">{item.label}</span>
        </a>
      );
    })
  }
</nav>
