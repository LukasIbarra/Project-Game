---
// Fase 4.1B: pantalla de inicio simple, sobre el sistema de paneles y
// los íconos SVG nuevos. Sigue sin ser la Home definitiva del juego (eso
// es contenido real, fuera de alcance) — solo una landing coherente
// post-login.
//
// Fase 11: "Estado del personaje" usa datos reales (mismo módulo
// game/state/playerState.ts que usa el HUD, un solo lugar que sabe pintar
// nivel/XP/monedas).
//
// Fase 12: "Actividad reciente" ahora es un feed real contra GET
// /v1/activity -mismo patrón de polling + after_id que GlobalChat.astro,
// sin WebSockets-. El backend nunca traduce `type` a texto: ese mapeo vive
// acá (ver `describeActivity` en el script), así que agregar un `type`
// nuevo en una fase futura (Fase 16 tienda, 17 combate recibido, 21/22
// expedición/mundo) es solo sumar un caso, sin tocar el backend.
import AppShell from "../layouts/AppShell.astro";
import GameButton from "../components/ui/GameButton.astro";
import GameBadge from "../components/ui/GameBadge.astro";
import GamePanel from "../components/ui/GamePanel.astro";
import Icon, { type IconName } from "../components/ui/Icon.astro";
import ProgressBar from "../components/ui/ProgressBar.astro";
import ResourceCounter from "../components/ui/ResourceCounter.astro";

const quickLinks: { href: string; label: string; icon: IconName }[] = [
  { href: "/house", label: "Casa", icon: "house" },
  { href: "/pet", label: "Mascota", icon: "pet" },
  { href: "/arena", label: "Arena", icon: "arena" },
  { href: "/play", label: "Mundo", icon: "world" },
];
---

<AppShell title="Inicio">
	<div class="mx-auto flex w-full max-w-3xl flex-col gap-4 py-4">
		<GamePanel notched bodyClass="flex flex-col items-center gap-3 px-10 py-8 text-center">
			<h1 class="m-0 text-lg text-text">Bienvenido de vuelta</h1>
			<p class="m-0 max-w-md text-sm leading-relaxed text-muted">
				Esta es tu pantalla de inicio. Desde la navegación de la izquierda vas a poder
				entrar a tu casa, tu mascota, la arena y el resto de módulos a medida que se
				construyan.
			</p>
			<GameButton href="/play" variant="outline" color="cyan">Entrar al Mundo →</GameButton>
		</GamePanel>

		<div class="grid gap-4 sm:grid-cols-2">
			<GamePanel title="Estado del personaje" bodyClass="flex flex-col gap-3 p-5">
				<div class="flex items-center justify-between">
					<GameBadge id="home-level" text="Nv. --" variant="cyan" />
				</div>
				<ProgressBar percent={0} color="cyan" title="Experiencia" fillId="home-exp-fill" />
				<div class="flex gap-4">
					<ResourceCounter icon="coin" value="…" color="pink" title="Monedas" valueId="home-coins" />
				</div>
			</GamePanel>

			<GamePanel title="Actividad reciente" bodyClass="flex flex-col gap-2 p-5">
				<ul
					id="activity-feed-list"
					class="m-0 flex max-h-48 list-none flex-col gap-2 overflow-y-auto p-0 text-sm text-muted"
				>
					<li id="activity-feed-empty" class="border-l-2 border-outline-strong pl-2">
						Sin actividad todavía.
					</li>
				</ul>
			</GamePanel>
		</div>

		<GamePanel title="Accesos rápidos" bodyClass="flex flex-col gap-3 p-5">
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
				{quickLinks.map((link) => (
					<a
						href={link.href}
						class="flex flex-col items-center gap-1 border border-outline-strong px-3 py-4 text-center text-muted hover:border-cyan hover:text-cyan"
					>
						<Icon name={link.icon} class="h-6 w-6" />
						<span class="text-xs">{link.label}</span>
					</a>
				))}
			</div>
		</GamePanel>
	</div>
</AppShell>

<script>
	import { getActivityEvents, type ActivityEventDto, type CharacterDto } from "../game/net/ApiClient";
	import { PLAYER_STATE_CHANGED_EVENT, expPercent, refreshPlayerState } from "../game/state/playerState";

	const levelEl = document.getElementById("home-level")!;
	const expFillEl = document.getElementById("home-exp-fill") as HTMLElement | null;
	const coinsEl = document.getElementById("home-coins")!;

	function renderPlayerState(character: CharacterDto): void {
		levelEl.textContent = `Nv. ${character.level}`;
		if (expFillEl) {
			expFillEl.style.width = `${expPercent(character)}%`;
		}
		coinsEl.textContent = character.coins.toLocaleString();
	}

	refreshPlayerState()
		.then(renderPlayerState)
		.catch(() => {
			coinsEl.textContent = "?";
		});

	window.addEventListener(PLAYER_STATE_CHANGED_EVENT, (event) => {
		renderPlayerState((event as CustomEvent<CharacterDto>).detail);
	});

	// Fase 12: Activity Feed. Mismo patrón que GlobalChat.astro -polling con
	// after_id, sin WebSockets-, pero con un intervalo más relajado (10s):
	// a diferencia del chat, "actividad reciente" no es una conversación en
	// vivo, no hace falta pollear cada 2.5s.
	const ACTIVITY_POLL_INTERVAL_MS = 10000;

	const activityListEl = document.getElementById("activity-feed-list")!;
	const activityEmptyEl = document.getElementById("activity-feed-empty")!;

	function relativeTime(iso: string): string {
		const diffSec = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
		if (diffSec < 60) return "hace un momento";
		const diffMin = Math.round(diffSec / 60);
		if (diffMin < 60) return `hace ${diffMin} min`;
		const diffHr = Math.round(diffMin / 60);
		if (diffHr < 24) return `hace ${diffHr} h`;
		return `hace ${Math.round(diffHr / 24)} d`;
	}

	// El backend nunca traduce `type` a texto (ver ApiClient.ts) -ese mapeo
	// vive acá para que agregar un tipo nuevo en una fase futura sea solo
	// sumar un `case`, sin tocar el endpoint.
	function describeActivity(event: ActivityEventDto): string {
		const p = event.payload as Record<string, any>;
		switch (event.type) {
			case "level_up":
				return `⬆ ¡Subiste a nivel ${p.new_level}!`;
			case "combat_attacked":
			// "combat": tipo legado (Fase 12-16, antes de que Fase 17 separara
			// atacante/defensor) -mismo texto que combat_attacked, para que
			// filas viejas ya guardadas en la DB de desarrollo sigan
			// mostrándose en vez de caer al default genérico.
			case "combat":
				return p.result === "victory"
					? `⚔ Ganaste un combate contra ${p.opponent_name} (+${p.xp} XP, +${p.coins} 💰)`
					: `⚔ Perdiste un combate contra ${p.opponent_name}`;
			case "combat_defended":
				return p.result === "victory"
					? `🛡 Repeliste un ataque de ${p.opponent_name} (+${p.xp} XP, +${p.coins} 💰)`
					: `🛡 ${p.opponent_name} te atacó y te venció (+${p.xp} XP, +${p.coins} 💰)`;
			case "expedition_claimed":
				return `🐾 Tu mascota volvió de ${p.destination_name}`;
			case "sale":
				return `💰 Vendiste ${p.quantity}x ${p.item_name} por ${p.coins_earned} monedas`;
			case "crafting":
				return `🔨 Fabricaste ${p.quantity}x ${p.result_item_name}`;
			case "purchase":
				return `🛒 Compraste ${p.quantity}x ${p.item_name} por ${p.coins_spent} monedas`;
			default:
				return "Actividad reciente";
		}
	}

	function isNearBottom(): boolean {
		return activityListEl.scrollTop + activityListEl.clientHeight >= activityListEl.scrollHeight - 24;
	}

	function renderActivityEvent(event: ActivityEventDto): void {
		activityEmptyEl.classList.add("hidden");

		const item = document.createElement("li");
		item.className = "border-l-2 border-outline-strong pl-2";

		const text = document.createElement("span");
		text.textContent = describeActivity(event);
		item.appendChild(text);

		const time = document.createElement("span");
		time.className = "ml-1 text-[10px] text-muted";
		time.textContent = relativeTime(event.created_at);
		item.appendChild(time);

		activityListEl.appendChild(item);
	}

	function initActivityFeed(): void {
		let lastId = 0;
		let stopped = false;

		async function tick(): Promise<void> {
			if (stopped) return;
			try {
				const events = await getActivityEvents(lastId || undefined);
				if (events.length > 0) {
					const stickToBottom = lastId === 0 || isNearBottom();
					lastId = Math.max(lastId, ...events.map((e) => e.id));
					events.forEach(renderActivityEvent);
					if (stickToBottom) {
						activityListEl.scrollTop = activityListEl.scrollHeight;
					}
				}
			} catch {
				// Backend caído o sesión inválida: el feed no debe romper la
				// página, simplemente no se actualiza hasta el próximo tick.
			}
		}

		tick();
		const timer = setInterval(tick, ACTIVITY_POLL_INTERVAL_MS);
		window.addEventListener("pagehide", () => {
			stopped = true;
			clearInterval(timer);
		});
	}

	initActivityFeed();
</script>
