  arena: "M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3Z M9 11l2 2 4-4",
  world: "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M3.8 9h16.4 M3.8 15h16.4 M12 3.5c2.2 2.3 3.4 5.2 3.4 8.5s-1.2 6.2-3.4 8.5c-2.2-2.3-3.4-5.2-3.4-8.5s1.2-6.2 3.4-8.5Z",
  social: "M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M15.5 11a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z M3.5 19c.4-3 2.4-5 5-5s4.6 2 5 5 M13.5 14.4c2 .2 3.5 2 3.8 4.6",
  inventory: "M4 8.5 12 5l8 3.5v9L12 21l-8-3.5v-9Z M4 8.5 12 12l8-3.5 M12 12v9",
  ranking: "M5 21v-6h4v6H5Z M10 21V9h4v12h-4Z M15 21v-9h4v9h-4Z",
  chat: "M4 5.5h16v10H9l-4 3.5v-3.5H4v-10Z M7.5 9.5h9 M7.5 12.5h6",
  bell: "M12 3.5c-2 0-3.5 1.6-3.5 3.6v2.7c0 1-.4 2-1.1 2.8L6 14.5h12l-1.4-1.9a4.2 4.2 0 0 1-1.1-2.8V7.1c0-2-1.5-3.6-3.5-3.6Z M10 17.5a2 2 0 0 0 4 0",
  logout: "M9 4H5.5v16H9 M14 8l4 4-4 4 M18 12H10",
  coin: "M12 4.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Z M12 8v8 M9.5 10a2.5 2 0 0 1 5 0c0 1-1 1.6-2.5 2s-2.5 1-2.5 2a2.5 2 0 0 0 5 0",
