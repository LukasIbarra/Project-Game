---
// Fase 10.5.1: reemplaza el formulario HTML plano de Fase 1. Misma
// arquitectura de siempre (POST /api/v1/auth/register ya crea el
// Character con appearance por defecto, ver AuthController) -no se
// agrega ningún paso de personalización todavía, eso es F11-.
import PublicLayout from "../layouts/PublicLayout.astro";
import GamePanel from "../components/ui/GamePanel.astro";
import GameInput from "../components/ui/GameInput.astro";
---

<PublicLayout title="Crear personaje — Adventure">
	<main class="relative flex min-h-screen w-full items-center justify-center px-4 py-10">
		<div
			class="pointer-events-none fixed inset-0 bg-cover bg-center opacity-[0.14]"
			style="background-image: url('/backgrounds/fondo_001.png'); image-rendering: pixelated;"
			aria-hidden="true"
		>
		</div>
		<div class="pointer-events-none fixed inset-0 bg-bg/70" aria-hidden="true"></div>

		<div class="relative z-10 flex w-full max-w-sm flex-col gap-3">
			<a href="/" class="self-start font-mono text-[0.65rem] uppercase tracking-wide text-muted transition-colors hover:text-cyan">
				← Volver al mundo
			</a>

			<GamePanel notched bodyClass="flex flex-col gap-4 p-6">
				<div class="text-center">
					<h1 class="m-0 font-display text-sm text-cyan">CREA TU PERSONAJE</h1>
					<p class="m-0 mt-2 text-xs text-muted">Todo aventurero tiene que empezar en algún lugar.</p>
				</div>

				<p id="error-message" class="hidden border border-red px-3 py-2 text-center text-xs text-red"></p>

				<form id="register-form" class="flex flex-col gap-3">
					<GameInput label="Nombre" name="name" autocomplete="name" />
					<GameInput label="Correo" name="email" type="email" autocomplete="email" />
					<GameInput label="Contraseña" name="password" type="password" autocomplete="new-password" minlength={8} />
					<GameInput
						label="Confirmar contraseña"
						name="password_confirmation"
						type="password"
						autocomplete="new-password"
						minlength={8}
					/>

					<button
						type="submit"
						id="submit-button"
						class="mt-1 border-2 border-pink bg-pink px-4 py-2 font-display text-xs text-bg transition-transform hover:scale-[1.02] active:scale-95 disabled:cursor-not-allowed disabled:opacity-50"
					>
						CREAR PERSONAJE
					</button>
				</form>

				<p class="m-0 text-center text-xs text-muted">
					¿Ya tenés personaje? <a href="/login" class="text-cyan hover:underline">Iniciá sesión</a>
				</p>
			</GamePanel>
		</div>
	</main>

	<script>
		import { errorMessage, register } from "../game/net/ApiClient";

		const form = document.getElementById("register-form") as HTMLFormElement;
		const errorEl = document.getElementById("error-message")!;
		const submitButton = document.getElementById("submit-button") as HTMLButtonElement;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			errorEl.classList.add("hidden");
			submitButton.disabled = true;

			const data = new FormData(form);
			const name = String(data.get("name") ?? "");
			const email = String(data.get("email") ?? "");
			const password = String(data.get("password") ?? "");
			const passwordConfirmation = String(data.get("password_confirmation") ?? "");

			try {
				await register(name, email, password, passwordConfirmation);
				window.location.href = "/home";
			} catch (err) {
				errorEl.textContent = errorMessage(err, "No se pudo crear el personaje.");
				errorEl.classList.remove("hidden");
				submitButton.disabled = false;
			}
		});
	</script>
</PublicLayout>
