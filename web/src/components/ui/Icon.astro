---
// Fase 4.1B: registro central de íconos. Originalmente 100% placeholders
// vectoriales -para dejar de depender de emojis, que rompían la identidad
// visual y variaban de un sistema operativo a otro-.
//
// Auditoría de iconografía (post Fase 12): se curaron 3 packs pixel-art
// (Raven Fantasy Icons, MF_Items, UI Icons 3 -ver ROADMAP.md/reporte de la
// tarea-) y se reemplazaron por pixel-art real los conceptos donde un
// ícono curado comunicaba mejor que la línea genérica (Nav/HUD). El resto
// -controles de UI pura: cerrar/chevrons/chat/notificaciones- sigue en
// SVG a propósito, tal como se decidió en esa auditoría. `PIXEL_ICONS`
// tiene prioridad sobre `paths`: un `name` con entrada acá se resuelve
// como <img>, nunca como <svg>, así que un mismo `name` nunca golpea las
// dos rutas de render.
//
// Ajuste puntual post-auditoría (pedido directo, sin volver a auditar los
// packs): "home" y "pet" pasan a pixel-art (antes sin candidato); "coin"
// cambia de sprite -el coin stack anterior queda parqueado sin usar como
// `coin_stack_unused.png`, nunca borrado-. Los tres nuevos salen
// específicamente de `UI Icons 3` (icon62->home.png, icon61->pet.png,
// icon7->coin.png).
// Fase 14 (Toast Notifications): 4 íconos nuevos de UI pura -mismo criterio
// que chat/bell/chevrons (línea SVG, no pixel-art: son indicadores de
// estado de la interfaz, no conceptos RPG)-. Ningún ícono existente
// representaba success/error/info/warning; se agregan acá en vez de
// reusar uno ajeno (ej. "bell" para error) para no depender solo del color
// como exige la fase.
// Fase 17 (Historial de Combates): 5 conceptos nuevos, los 5 con candidato
// real ya curado en la auditoría (ninguno nuevo se agrega a los packs) -
// "attack"/"shield" para el rol (ataqué / me atacaron), "victory"/"defeat"
// para el resultado (siempre junto a texto, nunca solo el color verde/rojo),
// "history" para el panel. Todos pixel-art -son conceptos RPG, no
// controles de UI-, mismo criterio que arena/coin/craft.
export type IconName =
  | "home"
  | "house"
  | "pet"
  | "arena"
  | "world"
  | "social"
  | "inventory"
  | "ranking"
  | "chat"
  | "bell"
  | "logout"
  | "coin"
  | "craft"
  | "shop"
  | "attack"
  | "shield"
  | "victory"
  | "defeat"
  | "history"
  | "chevron-down"
  | "chevron-right"
  | "toast-success"
  | "toast-error"
  | "toast-info"
  | "toast-warning";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;

// Íconos pixel-art curados en web/public/assets/icons/rpg/ -ver reporte de
// auditoría-. Rutas planas (mismo patrón ya usado por assets/pets/*.png en
// pet.astro): no pasan por el manifest de Phaser porque no son parte de
// ese pipeline (CLAUDE.md #5 es específicamente para personajes/tiles).
const PIXEL_ICONS: Partial<Record<IconName, string>> = {
  home: "/assets/icons/rpg/home.png",
  house: "/assets/icons/rpg/house.png",
  pet: "/assets/icons/rpg/pet.png",
  arena: "/assets/icons/rpg/arena.png",
  world: "/assets/icons/rpg/compass.png",
  social: "/assets/icons/rpg/friendship.png",
  inventory: "/assets/icons/rpg/bag.png",
  ranking: "/assets/icons/rpg/crown.png",
  craft: "/assets/icons/rpg/anvil.png",
  coin: "/assets/icons/rpg/coin.png",
  // Fase 16: ya estaba parqueado sin usar desde la auditoría de iconos
  // (Grupo B, reservado explícitamente para esta fase) -no se sumó ni
  // se reorganizó ningún pack nuevo.
  shop: "/assets/icons/rpg/shop_cart.png",
  // Excepción documentada en la auditoría: "logout" es un control, no un
  // concepto RPG, pero ningún SVG de línea comunicaba "salir" mejor que
  // esta puerta -y a diferencia de cerrar/chevrons/chat, acá sí había un
  // reemplazo claramente superior-.
  logout: "/assets/icons/rpg/door.png",
  // Fase 17: ya curados en la auditoría original, sin usar hasta ahora.
  attack: "/assets/icons/rpg/attack_fist.png",
  shield: "/assets/icons/rpg/shield_holy.png",
  victory: "/assets/icons/rpg/cup.png",
  defeat: "/assets/icons/rpg/skull.png",
  history: "/assets/icons/ui/hourglass_time.png",
};

// Solo los nombres que NO están en PIXEL_ICONS necesitan trazo SVG.
const paths: Partial<Record<IconName, string>> = {
  chat: "M4 5.5h16v10H9l-4 3.5v-3.5H4v-10Z M7.5 9.5h9 M7.5 12.5h6",
  bell: "M12 3.5c-2 0-3.5 1.6-3.5 3.6v2.7c0 1-.4 2-1.1 2.8L6 14.5h12l-1.4-1.9a4.2 4.2 0 0 1-1.1-2.8V7.1c0-2-1.5-3.6-3.5-3.6Z M10 17.5a2 2 0 0 0 4 0",
  "chevron-down": "m6 9 6 6 6-6",
  "chevron-right": "m9 6 6 6-6 6",
  "toast-success": "m5 12.5 4.5 4.5L19 7",
  "toast-error": "M6 6 18 18 M18 6 6 18",
  "toast-info": "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M12 10.5v6 M12 7.5h.01",
  "toast-warning": "M12 3.5 2.5 20h19L12 3.5Z M12 10v4 M12 17h.01",
};

const pixelSrc = PIXEL_ICONS[name];
---

{
  pixelSrc ? (
    <img
      src={pixelSrc}
      width="16"
      height="16"
      class={className}
      style="image-rendering: pixelated;"
      alt=""
      aria-hidden="true"
    />
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      <path d={paths[name]} />
    </svg>
  )
}
