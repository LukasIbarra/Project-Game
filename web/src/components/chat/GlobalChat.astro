---
// Chat global real (polling HTTP cada ~2.5s contra /api/v1/chat/messages
// vía ApiClient — nunca fetch directo, ver ApiClient.ts). Reemplaza el
// mock en memoria de la Fase 4.1B: ahora los mensajes se persisten en
// `chat_messages` y los ve cualquiera conectado.
//
// Diseño pensado para poder migrar a WebSockets después sin rehacer esto
// (ver "Compatibilidad con multiplayer futuro" en el reporte de la
// tarea): toda la lógica de "cómo llegan los mensajes nuevos" vive
// aislada en `createPollingSource()`, con la forma {start, stop}. El
// resto del componente (render, scroll, input) solo consume mensajes ya
// resueltos vía el callback `onMessages` — no sabe ni le importa que hoy
// vengan de polling. Reemplazar esa función por una que abra un
// WebSocket y llame el mismo callback es el único cambio que haría
// falta.
import GameButton from "../ui/GameButton.astro";
import Icon from "../ui/Icon.astro";
---

<!-- Mobile UX: en desktop (md+) es exactamente el mismo panel lateral de
     siempre -sin cambios de comportamiento-. Por debajo de md arranca
     "hidden" (cerrado por defecto, cero espacio reservado, no empuja el
     <main>) y el mismo botón de chat del HUD lo abre como drawer flotante
     -ver script: initGlobalChat() decide en el momento del click si
     corresponde el colapso a riel de escritorio o el abrir/cerrar de
     mobile, según el viewport actual-. El backdrop solo existe para poder
     cerrar tocando afuera; en desktop nunca se muestra. -->
<div
  id="global-chat-backdrop"
  class="fixed inset-0 z-30 hidden bg-black/70 md:hidden"
  aria-hidden="true"
></div>

<section
  id="global-chat"
  class="game-panel game-panel--notched hidden min-h-0 max-h-full flex-col md:m-2 md:ml-0 md:flex md:w-64 md:shrink-0"
>
  <header class="game-panel__header text-cyan shrink-0">
    <span id="global-chat-title">Chat Global</span>
    <button
      id="global-chat-toggle"
      aria-label="Minimizar chat"
      class="ml-auto text-muted hover:text-text"
    >
      <Icon name="chevron-down" class="h-3.5 w-3.5" />
    </button>
  </header>

  <div id="global-chat-body" class="flex flex-1 min-h-0 flex-col overflow-hidden">
    <ul id="global-chat-messages" class="flex flex-1 min-h-0 flex-col gap-1 overflow-y-auto px-3 py-2 text-xs">
      <!-- Se completa en runtime desde /api/v1/chat/messages -->
    </ul>

    <p id="global-chat-status" class="hidden shrink-0 px-3 pb-1 text-[10px] text-muted"></p>

    <form id="global-chat-form" class="flex shrink-0 gap-1 border-t border-outline-strong p-2">
      <input
        id="global-chat-input"
        type="text"
        maxlength="150"
        autocomplete="off"
        placeholder="Escribe un mensaje..."
        class="min-w-0 flex-1 border border-outline-strong bg-bg px-2 py-1 text-xs text-text placeholder:text-muted focus:border-cyan focus:outline-none"
      />
      <GameButton type="submit" variant="outline" color="cyan" id="global-chat-send">Enviar</GameButton>
    </form>
  </div>
</section>

<script>
  import {
    errorMessage,
    getChatMessages,
    sendChatMessage,
    type ChatMessageDto,
  } from "../../game/net/ApiClient";
  import { getEcho } from "../../game/net/Realtime";

  const POLL_INTERVAL_MS = 2500;
  const NEAR_BOTTOM_PX = 24;

  // Mismo breakpoint "md" que ya usa Tailwind acá (ver clases del
  // <section>) -por debajo de esto el panel arranca "hidden" y el toggle
  // pasa a abrir/cerrar un drawer en vez de colapsar a riel.
  const MOBILE_BREAKPOINT_PX = 768;
  const MOBILE_OPEN_CLASSES = ["flex", "fixed", "inset-x-3", "top-16", "bottom-20", "z-40"];

  function isMobileViewport(): boolean {
    return window.innerWidth < MOBILE_BREAKPOINT_PX;
  }

  const container = document.getElementById("global-chat")!;
  const backdrop = document.getElementById("global-chat-backdrop")!;

  // Guard contra doble-inicialización: si este script llegara a correr
  // dos veces sobre el mismo DOM (ej. una futura navegación client-side),
  // nunca queremos dos intervalos de polling compitiendo.
  if (container.dataset.chatInitialized === "true") {
    // no-op: ya inicializado
  } else {
    container.dataset.chatInitialized = "true";
    initGlobalChat(container);
  }

  function initGlobalChat(container: HTMLElement) {
    const list = document.getElementById("global-chat-messages")!;
    const form = document.getElementById("global-chat-form") as HTMLFormElement;
    const input = document.getElementById("global-chat-input") as HTMLInputElement;
    const sendButton = document.getElementById("global-chat-send") as HTMLButtonElement;
    const status = document.getElementById("global-chat-status")!;
    const body = document.getElementById("global-chat-body")!;
    const title = document.getElementById("global-chat-title")!;
    const toggle = document.getElementById("global-chat-toggle")!;
    const toggleIcon = toggle.querySelector("svg")!;

    const renderedIds = new Set<number>();

    function formatTime(iso: string): string {
      return new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    }

    function isNearBottom(): boolean {
      return list.scrollTop + list.clientHeight >= list.scrollHeight - NEAR_BOTTOM_PX;
    }

    function renderMessage(message: ChatMessageDto) {
      if (renderedIds.has(message.id)) return;
      renderedIds.add(message.id);

      const item = document.createElement("li");
      item.className = "text-text";

      const author = document.createElement("span");
      author.className = "text-pink";
      author.textContent = `${message.user_name}: `;
      item.appendChild(author);

      // Texto plano vía createTextNode/textContent, NUNCA innerHTML — es
      // lo único que hace falta para que el contenido del mensaje no
      // pueda inyectar HTML/JS (el backend no sanitiza el texto en sí,
      // la defensa contra XSS vive acá, en cómo se pinta).
      item.appendChild(document.createTextNode(message.message));

      const time = document.createElement("span");
      time.className = "ml-1 text-[10px] text-muted";
      time.textContent = formatTime(message.created_at);
      item.appendChild(time);

      list.appendChild(item);
    }

    function renderIncoming(messages: ChatMessageDto[]) {
      if (messages.length === 0) return;
      const stickToBottom = renderedIds.size === 0 || isNearBottom();
      messages.forEach(renderMessage);
      if (stickToBottom) {
        list.scrollTop = list.scrollHeight;
      }
    }

    function setStatus(text: string | null) {
      if (!text) {
        status.classList.add("hidden");
        status.textContent = "";
        return;
      }
      status.textContent = text;
      status.classList.remove("hidden");
    }

    // Fuente de mensajes vía polling — ver comentario de arriba del
    // archivo. `after_id` evita re-descargar todo el feed en cada tick.
    function createPollingSource(onMessages: (messages: ChatMessageDto[]) => void) {
      let lastId = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      let stopped = false;

      async function tick() {
        if (stopped) return;
        try {
          const messages = await getChatMessages(lastId || undefined);
          if (messages.length > 0) {
            lastId = Math.max(lastId, ...messages.map((m) => m.id));
            onMessages(messages);
          }
          setStatus(null);
        } catch (err) {
          setStatus(errorMessage(err, "No se pudo actualizar el chat."));
        }
      }

      return {
        async start() {
          setStatus("Cargando mensajes...");
          await tick();
          if (!stopped) {
            timer = setInterval(tick, POLL_INTERVAL_MS);
          }
        },
        stop() {
          stopped = true;
          if (timer !== null) {
            clearInterval(timer);
            timer = null;
          }
        },
        // Deja que un mensaje enviado por ESTE cliente entre por el mismo
        // camino que uno recibido por polling (mismo dedup, mismo
        // render), y adelanta el cursor para que el próximo tick no lo
        // vuelva a traer.
        notifyLocalMessage(message: ChatMessageDto) {
          lastId = Math.max(lastId, message.id);
          onMessages([message]);
        },
      };
    }

    // Fase Reverb: misma forma {start, stop, notifyLocalMessage} que
    // createPollingSource(), pero alimentando el canal privado "chat" de
    // Reverb en vez de un setInterval — corre EN PARALELO al polling,
    // nunca lo reemplaza. Si getEcho()/la suscripción fallan (ej. las
    // variables PUBLIC_REVERB_* todavía no están configuradas en este
    // entorno), el catch de abajo evita que eso tire abajo el resto de
    // initGlobalChat(); el polling sigue funcionando exactamente igual,
    // sin depender de esto en absoluto.
    function createWebSocketSource(onMessages: (messages: ChatMessageDto[]) => void) {
      type PrivateChannel = ReturnType<ReturnType<typeof getEcho>["private"]>;
      let channel: PrivateChannel | null = null;

      return {
        start() {
          try {
            channel = getEcho().private("chat");
            // El evento define broadcastAs() = "ChatMessageCreated" del
            // lado de Laravel -el punto inicial es obligatorio con un
            // nombre de broadcast customizado, si no Echo arma el nombre
            // completo por defecto (namespace + clase) y nunca matchea.
            channel.listen(".ChatMessageCreated", (message: ChatMessageDto) => {
              onMessages([message]);
            });
            channel.error((err: unknown) => {
              console.warn("No se pudo autorizar el canal de chat en tiempo real -el polling sigue activo.", err);
            });
          } catch (err) {
            console.warn("No se pudo conectar el chat en tiempo real -el polling sigue activo.", err);
          }
        },
        stop() {
          if (channel) {
            getEcho().leaveChannel("chat");
            channel = null;
          }
        },
        // El mensaje propio ya se muestra al instante vía
        // source.notifyLocalMessage() (polling, ver abajo) — cuando Reverb
        // lo reenvíe por WebSocket va a traer el mismo id real y
        // renderedIds lo va a absorber sin duplicar nada. No hace falta
        // que este source haga nada acá.
        notifyLocalMessage() {},
      };
    }

    const source = createPollingSource(renderIncoming);
    source.start();

    const wsSource = createWebSocketSource(renderIncoming);
    wsSource.start();

    // No hace falta un event listener de "destrucción" explícito en un
    // sitio multi-page (cada navegación recarga el documento y mata el
    // intervalo/conexión solos) — esto es una red de seguridad barata para
    // el caso de bfcache/pagehide, sin asumir ningún router client-side.
    window.addEventListener("pagehide", () => {
      source.stop();
      wsSource.stop();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text || text.length > 150) return;

      input.value = "";
      sendButton.disabled = true;
      try {
        const sent = await sendChatMessage(text);
        source.notifyLocalMessage(sent);
        list.scrollTop = list.scrollHeight;
        setStatus(null);
      } catch (err) {
        input.value = text; // el usuario no pierde lo que escribió
        setStatus(errorMessage(err, "No se pudo enviar el mensaje."));
      } finally {
        sendButton.disabled = false;
      }
    });

    // Mobile UX: abre/cierra el drawer completo (el panel entero estaba
    // "hidden" por defecto). Nunca toca w-10/w-64 -esas clases son
    // exclusivamente el colapso a riel de escritorio, de abajo-.
    function isMobileChatOpen(): boolean {
      return container.classList.contains("fixed");
    }

    function openMobileChat(): void {
      container.classList.remove("hidden");
      container.classList.add(...MOBILE_OPEN_CLASSES);
      backdrop.classList.remove("hidden");
      toggle.setAttribute("aria-label", "Cerrar chat");
    }

    function closeMobileChat(): void {
      container.classList.add("hidden");
      container.classList.remove(...MOBILE_OPEN_CLASSES);
      backdrop.classList.add("hidden");
      toggle.setAttribute("aria-label", "Abrir chat");
    }

    backdrop.addEventListener("click", closeMobileChat);

    // Mismo botón, dos comportamientos según el viewport en el momento del
    // click (no una media query fija en JS): en mobile abre/cierra el
    // drawer entero; en desktop conserva el colapso a riel angosto de
    // siempre, sin ningún cambio de comportamiento.
    toggle.addEventListener("click", () => {
      if (isMobileViewport()) {
        if (isMobileChatOpen()) {
          closeMobileChat();
        } else {
          openMobileChat();
        }
        return;
      }

      // Colapsa a un riel angosto (solo el header) en vez de ocultar sin
      // liberar el espacio -así el contenido central puede usarlo.
      const collapsed = container.classList.toggle("w-10");
      container.classList.toggle("w-64", !collapsed);
      body.classList.toggle("hidden", collapsed);
      title.classList.toggle("hidden", collapsed);
      toggleIcon.classList.toggle("-rotate-90", collapsed);
    });
  }
</script>
