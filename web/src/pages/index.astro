---
// Fase 10.5.1 — Landing pública de Chibikko.
//
// Pantalla pública sin HUD/Nav/Chat.
// Mantiene la identidad visual pixel-art del juego.
//
// Assets:
// public/backgrounds/fondo_inicio.png
// public/backgrounds/logo.png

import PublicLayout from "../layouts/PublicLayout.astro";
import Icon, { type IconName } from "../components/ui/Icon.astro";

const features: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "world",
		title: "EXPLORA",
		text: "Descubre pequeños lugares y secretos.",
	},
	{
		icon: "pet",
		title: "CUIDA",
		text: "Envía a tu mascota a explorar mientras estás fuera.",
	},
	{
		icon: "craft",
		title: "CONSTRUYE",
		text: "Consigue recursos, fabrica objetos y decora tu casa.",
	},
	{
		icon: "arena",
		title: "COMBATE",
		text: "Enfréntate a otros aventureros.",
	},
];

const petals = Array.from({ length: 18 }, (_, i) => ({
	id: i,
	left: `${(i * 17 + 7) % 100}%`,
	delay: `${-((i * 1.7) % 12)}s`,
	duration: `${10 + (i % 7)}s`,
	size: 7 + (i % 4) * 2,
}));
---

<PublicLayout title="Chibikko — Un pequeño mundo, grandes aventuras">
	<main class="landing relative min-h-screen w-full overflow-hidden">

		<!-- ============================= -->
		<!-- FONDO                         -->
		<!-- ============================= -->

		<div
			class="landing-background absolute inset-0"
			aria-hidden="true"
		></div>

		<!-- Oscurece bordes sin tapar la ilustración -->
		<div
			class="landing-vignette absolute inset-0"
			aria-hidden="true"
		></div>

		<!-- ============================= -->
		<!-- PÉTALOS DE SAKURA             -->
		<!-- ============================= -->

		<div class="petals pointer-events-none absolute inset-0 z-[2] overflow-hidden" aria-hidden="true">
			{petals.map((petal) => (
				<span
					class="sakura-petal"
					style={`
						--left:${petal.left};
						--delay:${petal.delay};
						--duration:${petal.duration};
						--size:${petal.size}px;
					`}
				>
					<svg
						viewBox="0 0 16 16"
						width="16"
						height="16"
						aria-hidden="true"
					>
						<path
							d="M8 15C6 11 2 10 2 6C2 3 5 1 8 5C11 1 14 3 14 6C14 10 10 11 8 15Z"
							fill="currentColor"
						/>
					</svg>
				</span>
			))}
		</div>

		<!-- ============================= -->
		<!-- CONTENIDO                     -->
		<!-- ============================= -->

		<div
			class="relative z-10 flex min-h-screen flex-col items-center justify-between px-4 py-7 sm:py-10"
		>

			<!-- Espacio superior -->
			<div></div>

			<!-- HERO -->
			<section
				class="landing-fade-in flex flex-col items-center text-center"
			>

				<!-- LOGO -->
				<img
					src="/backgrounds/logo.png"
					alt="Chibikko"
					class="chibikko-logo mb-4 w-[300px] max-w-[78vw] select-none sm:w-[390px] lg:w-[460px]"
					draggable="false"
				/>

				<!-- Slogan -->
				<p
					class="landing-subtitle mb-7 font-mono text-sm text-white/90 sm:text-base"
				>
					Un pequeño mundo, grandes aventuras.
				</p>

				<!-- BOTONES -->
				<div class="flex w-[260px] flex-col gap-3 sm:w-[290px]">

					<a
						id="cta-play"
						href="/register"
						class="pixel-button pixel-button-primary"
					>
						<span>JUGAR</span>
					</a>

					<a
						href="/register"
						class="pixel-button pixel-button-secondary"
					>
						<span>CREAR PERSONAJE</span>
					</a>

					<a
						href="/login"
						class="login-link"
					>
						INICIAR SESIÓN
					</a>

				</div>

			</section>

			<!-- FEATURES -->
			<section
				class="landing-fade-in features-panel w-full max-w-3xl"
				style="animation-delay:160ms;"
			>
				<div
					class="flex flex-wrap items-start justify-center gap-x-5 gap-y-4 sm:flex-nowrap"
				>
					{features.map((feature, index) => (
						<>
							{index > 0 && (
								<div class="feature-divider hidden sm:block" />
							)}

							<div
								class="feature flex min-w-[9rem] flex-1 flex-col items-center gap-1.5 text-center"
							>
								<Icon
									name={feature.icon}
									class="h-5 w-5 text-cyan"
								/>

								<span class="font-display text-[0.6rem] text-white">
									{feature.title}
								</span>

								<span class="text-[0.7rem] leading-snug text-white/60">
									{feature.text}
								</span>
							</div>
						</>
					))}
				</div>
			</section>

		</div>
	</main>

	<script>
		import { isAuthenticated } from "../game/net/ApiClient";

		const playButton =
			document.getElementById("cta-play") as HTMLAnchorElement;

		if (playButton && isAuthenticated()) {
			playButton.href = "/play";
		}
	</script>
</PublicLayout>


<style>

	/* =========================================================
	   BACKGROUND
	   ========================================================= */

	.landing {
		background: #050a18;
	}

	.landing-background {
		background-image: url("/backgrounds/fondo_inicio.png");
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;

		image-rendering: pixelated;

		transform: scale(1.01);

		animation:
			background-enter 1.3s ease-out both;
	}

	/*
	 * En vez del overlay negro uniforme anterior,
	 * dejamos el centro relativamente limpio.
	 */

	.landing-vignette {
		background:
			radial-gradient(
				ellipse at center,
				transparent 20%,
				rgba(3, 7, 20, 0.08) 50%,
				rgba(3, 7, 20, 0.55) 100%
			),
			linear-gradient(
				to bottom,
				rgba(3, 7, 20, 0.12),
				transparent 35%,
				transparent 65%,
				rgba(3, 7, 20, 0.55)
			);
	}


	/* =========================================================
	   LOGO
	   ========================================================= */

	.chibikko-logo {
		image-rendering: pixelated;

		filter:
			drop-shadow(0 5px 0 rgba(10, 4, 30, 0.75))
			drop-shadow(0 0 18px rgba(255, 119, 190, 0.18));

		animation:
			logo-enter 700ms ease-out both,
			logo-float 4s ease-in-out 800ms infinite;
	}


	/* =========================================================
	   TEXTO
	   ========================================================= */

	.landing-subtitle {
		text-shadow:
			0 2px 0 rgba(0, 0, 0, 0.8),
			0 0 8px rgba(0, 0, 0, 0.7);
	}


	/* =========================================================
	   BOTONES
	   ========================================================= */

	.pixel-button {
		position: relative;

		display: flex;
		align-items: center;
		justify-content: center;

		min-height: 46px;

		padding: 0.75rem 1.5rem;

		font-family: var(--font-display);
		font-size: 0.72rem;
		letter-spacing: 0.05em;

		transition:
			transform 120ms ease,
			filter 120ms ease,
			background-color 120ms ease;

		image-rendering: pixelated;
	}


	.pixel-button-primary {
		color: white;

		background:
			linear-gradient(
				to bottom,
				#ef73a8,
				#c53b78
			);

		border: 2px solid #ffb5d5;

		box-shadow:
			0 0 0 2px #35194c,
			0 5px 0 #35194c,
			0 8px 18px rgba(0, 0, 0, 0.35);
	}


	.pixel-button-primary:hover {
		transform: translateY(-2px);

		filter: brightness(1.12);

		box-shadow:
			0 0 0 2px #35194c,
			0 7px 0 #35194c,
			0 10px 22px rgba(0, 0, 0, 0.4);
	}


	.pixel-button-primary:active {
		transform: translateY(3px);

		box-shadow:
			0 0 0 2px #35194c,
			0 2px 0 #35194c;
	}


	.pixel-button-secondary {
		color: #ffd4e8;

		background: rgba(8, 18, 45, 0.78);

		border: 2px solid rgba(237, 111, 174, 0.8);

		box-shadow:
			0 0 0 1px rgba(8, 13, 35, 0.9),
			0 4px 0 rgba(8, 13, 35, 0.9);

		backdrop-filter: blur(3px);
	}


	.pixel-button-secondary:hover {
		transform: translateY(-2px);

		background: rgba(39, 26, 67, 0.92);

		border-color: #ff9acb;
	}


	.login-link {
		margin-top: 3px;

		font-family: var(--font-mono);

		font-size: 0.68rem;

		letter-spacing: 0.12em;

		color: rgba(255, 255, 255, 0.65);

		text-shadow: 0 2px 2px black;

		transition: color 150ms ease;
	}


	.login-link:hover {
		color: #ffc4df;
	}


	/* =========================================================
	   FEATURES
	   ========================================================= */

	.features-panel {
		padding: 0.85rem 1rem;

		background: rgba(4, 13, 34, 0.72);

		border: 1px solid rgba(106, 195, 220, 0.38);

		box-shadow:
			0 0 0 1px rgba(9, 5, 29, 0.85),
			0 5px 20px rgba(0, 0, 0, 0.28);

		backdrop-filter: blur(5px);
	}


	.feature {
		transition: transform 150ms ease;
	}


	.feature:hover {
		transform: translateY(-2px);
	}


	.feature-divider {
		width: 1px;
		height: 46px;

		background:
			linear-gradient(
				to bottom,
				transparent,
				rgba(116, 207, 225, 0.35),
				transparent
			);
	}


	/* =========================================================
	   SAKURA
	   ========================================================= */

	.sakura-petal {
		position: absolute;

		top: -30px;
		left: var(--left);

		width: var(--size);
		height: var(--size);

		color: #f5a4c7;

		opacity: 0;

		filter:
			drop-shadow(1px 1px 0 rgba(80, 25, 65, 0.4));

		animation:
			sakura-fall var(--duration) linear var(--delay) infinite;

		image-rendering: pixelated;
	}


	.sakura-petal svg {
		display: block;

		width: 100%;
		height: 100%;
	}


	/* =========================================================
	   ANIMACIONES
	   ========================================================= */

	@keyframes sakura-fall {

		0% {
			transform:
				translate3d(-100px, -10vh, 0)
				rotate(0deg);

			opacity: 0;
		}

		8% {
			opacity: 0.85;
		}

		45% {
			transform:
				translate3d(70px, 45vh, 0)
				rotate(170deg);
		}

		100% {
			transform:
				translate3d(180px, 110vh, 0)
				rotate(380deg);

			opacity: 0.2;
		}
	}


	@keyframes logo-enter {

		from {
			opacity: 0;

			transform:
				translateY(-15px)
				scale(0.94);
		}

		to {
			opacity: 1;

			transform:
				translateY(0)
				scale(1);
		}
	}


	@keyframes logo-float {

		0%,
		100% {
			transform: translateY(0);
		}

		50% {
			transform: translateY(-5px);
		}
	}


	@keyframes landing-fade-in {

		from {
			opacity: 0;

			transform: translateY(10px);
		}

		to {
			opacity: 1;

			transform: translateY(0);
		}
	}


	@keyframes background-enter {

		from {
			opacity: 0;

			transform: scale(1.04);
		}

		to {
			opacity: 1;

			transform: scale(1.01);
		}
	}


	.landing-fade-in {
		animation:
			landing-fade-in 600ms ease-out both;
	}


	/* =========================================================
	   MOBILE
	   ========================================================= */

	@media (max-width: 640px) {

		.features-panel {
			max-width: 94%;
		}

		.sakura-petal:nth-child(even) {
			display: none;
		}

	}


	/* Accesibilidad */

	@media (prefers-reduced-motion: reduce) {

		.landing-fade-in,
		.chibikko-logo,
		.landing-background,
		.sakura-petal {
			animation: none;
		}

		.sakura-petal {
			display: none;
		}

	}

</style>