# No versionado / no necesario dentro de la imagen -mismo espíritu que
# .gitignore, pero para el build de Docker (contexto más chico = build más
# rápido, y evita que .env local termine adentro de una imagen).
.env
.env.*
!.env.example

.git
.gitignore

vendor/
node_modules/

tests/
.phpunit.cache
.phpunit.result.cache
phpunit.xml

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
!storage/logs/.gitignore
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/framework/testing/.gitignore

.idea
.vscode
.fleet
Dockerfile
.dockerignore
README.md
