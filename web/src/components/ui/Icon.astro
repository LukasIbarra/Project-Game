---
// Fase 4.1B: registro central de íconos. Placeholders vectoriales simples
// y coherentes entre sí -NO son los sprites pixel-art definitivos-, para
// dejar de depender de emojis (que rompían la identidad visual y varían
// de un sistema operativo a otro). Reemplazar por pixel-art real más
// adelante = editar los `<path>` de acá, sin tocar el layout de quien
// los usa (Nav, HUD, Placeholder, etc. solo piden un `name`).
export type IconName =
  | "home"
  | "house"
  | "pet"
  | "arena"
  | "world"
  | "social"
  | "inventory"
  | "ranking"
  | "chat"
  | "bell"
  | "logout"
  | "coin"
  | "resource"
  | "craft"
  | "chevron-down"
  | "chevron-right";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<IconName, string> = {
  home: "M3 11.5 12 4l9 7.5 M5.5 10v9h13v-9 M10 19v-5h4v5",
  house: "M4 10 12 3l8 7 M6 9v10h5v-6h2v6h5V9",
